rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidLedgerId(id) { return id is string && id.size() > 0 && id.size() <= 240 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function hasRole(roleList) { return isSignedIn() && request.auth.token.role in roleList; }
    function isAdmin() { return isSignedIn() && request.auth.token.role == 'admin'; }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && incoming().keys().hasAll(['uid','name','email','photoUrl','isProfileVisible','createdAt','updatedAt'])
        && incoming().keys().hasOnly(['uid','name','email','photoUrl','isProfileVisible','createdAt','updatedAt'])
        && incoming().uid == userId
        && incoming().name is string
        && incoming().email is string
        && incoming().photoUrl is string
        && incoming().isProfileVisible is bool
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name','email','photoUrl','isProfileVisible','updatedAt'])
        && incoming().name is string
        && incoming().email is string
        && incoming().photoUrl is string
        && incoming().isProfileVisible is bool;

      match /tasks/{taskId} {
        allow read: if isSignedIn() && (
          userId == request.auth.uid ||
          (resource != null && 'sharedWith' in resource.data && resource.data.sharedWith is list && request.auth.uid in resource.data.sharedWith)
        );
        allow create: if isSignedIn() && userId == request.auth.uid;
        allow update: if isSignedIn() && (
          userId == request.auth.uid ||
          (resource != null && 'sharedWith' in resource.data && resource.data.sharedWith is list && request.auth.uid in resource.data.sharedWith)
        );
        allow delete: if isSignedIn() && userId == request.auth.uid;
      }
      match /favorites/{favoriteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /skills/{skillId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /relationshipNotificationPreferences/{storeId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(storeId)
          && incoming().storeId == storeId
          && incoming().enabled is bool
          && incoming().updatedAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 1
          && incoming().keys().hasAll(['storeId','enabled','updatedAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['storeId','enabled','updatedAt','recordedAt','schemaVersion']);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && isValidId(notificationId)
          && incoming().id == notificationId
          && incoming().kind == 'relationship'
          && incoming().recipientId == userId
          && incoming().senderStoreId == request.auth.uid
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 180
          && incoming().body is string
          && incoming().body.size() > 0
          && incoming().body.size() <= 2000
          && incoming().campaignId is string
          && incoming().benefitId is string
          && incoming().createdAt is string
          && incoming().readAt == ''
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 1
          && incoming().keys().hasAll(['id','kind','recipientId','senderStoreId','title','body','campaignId','benefitId','createdAt','readAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','kind','recipientId','senderStoreId','title','body','campaignId','benefitId','createdAt','readAt','recordedAt','schemaVersion']);
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && incoming().id == existing().id
          && incoming().kind == existing().kind
          && incoming().recipientId == existing().recipientId
          && incoming().senderStoreId == existing().senderStoreId
          && incoming().title == existing().title
          && incoming().body == existing().body
          && incoming().campaignId == existing().campaignId
          && incoming().benefitId == existing().benefitId
          && incoming().createdAt == existing().createdAt
          && incoming().recordedAt == existing().recordedAt
          && incoming().schemaVersion == existing().schemaVersion
          && incoming().readAt is string
          && incoming().readAt.size() > 0
          && incoming().readRecordedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['readAt','readRecordedAt']);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /personalizedBenefits/{benefitId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && isValidId(benefitId)
          && incoming().id == benefitId
          && incoming().buyerId == userId
          && incoming().storeId == request.auth.uid
          && incoming().buyerEmail is string
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 180
          && incoming().description is string
          && incoming().description.size() <= 2000
          && incoming().type in ['discount', 'voucher', 'free_product']
          && incoming().value is number
          && incoming().value >= 0
          && incoming().productName is string
          && incoming().code is string
          && incoming().startsAt is string
          && incoming().endsAt is string
          && incoming().active is bool
          && incoming().createdAt is string
          && incoming().updatedAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 2
          && incoming().keys().hasAll(['id','storeId','buyerId','buyerEmail','title','description','type','value','productName','code','startsAt','endsAt','active','createdAt','updatedAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','storeId','buyerId','buyerEmail','title','description','type','value','productName','code','startsAt','endsAt','active','campaignId','audienceSegment','createdAt','updatedAt','recordedAt','schemaVersion']);
        allow update: if false;
        allow delete: if isSignedIn() && (
          request.auth.uid == userId || request.auth.uid == existing().storeId || isAdmin()
        );
      }

      match /loyaltyLedger/{eventId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && isValidLedgerId(eventId)
          && incoming().buyerId == userId
          && incoming().storeId is string
          && incoming().storeId.size() > 0
          && incoming().id is string
          && incoming().type in ['earn', 'reversal', 'adjustment']
          && incoming().points is number
          && incoming().buyerEmail is string
          && incoming().orderId is string
          && incoming().reason is string
          && incoming().lines is list
          && incoming().sourceEventId is string
          && incoming().createdAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 2
          && (
            request.auth.uid == incoming().storeId ||
            (request.auth.uid == userId && incoming().type == 'adjustment' && incoming().points < 0)
          )
          && incoming().keys().hasAll(['id','storeId','buyerId','buyerEmail','orderId','type','points','reason','lines','sourceEventId','createdAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','storeId','buyerId','buyerEmail','orderId','type','points','reason','lines','sourceEventId','createdAt','recordedAt','schemaVersion']);
        allow update, delete: if false;
      }

      match /loyaltyChallengeCompletions/{completionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && isValidLedgerId(completionId)
          && incoming().id == completionId
          && incoming().buyerId == userId
          && incoming().storeId == request.auth.uid
          && incoming().challengeId is string
          && incoming().challengeTitle is string
          && incoming().buyerEmail is string
          && incoming().metric in ['paid_orders','points_earned']
          && incoming().achievedValue is number
          && incoming().target is number
          && incoming().rewardPoints is number
          && incoming().completedAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 2
          && incoming().keys().hasAll(['id','storeId','challengeId','challengeTitle','buyerId','buyerEmail','metric','achievedValue','target','rewardPoints','completedAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','storeId','challengeId','challengeTitle','buyerId','buyerEmail','metric','achievedValue','target','rewardPoints','completedAt','recordedAt','schemaVersion']);
        allow update, delete: if false;
      }

      match /loyaltyRewardRedemptions/{redemptionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && isValidLedgerId(redemptionId)
          && incoming().id == redemptionId
          && incoming().buyerId == userId
          && incoming().storeId is string
          && incoming().storeId.size() > 0
          && incoming().rewardId is string
          && incoming().rewardTitle is string
          && incoming().rewardType in ['discount','free_product','voucher']
          && incoming().buyerEmail is string
          && incoming().pointsCost is number
          && incoming().pointsCost > 0
          && incoming().benefitValue is number
          && incoming().productId is string
          && incoming().productName is string
          && incoming().status == 'issued'
          && incoming().createdAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 2
          && incoming().keys().hasAll(['id','storeId','rewardId','rewardTitle','rewardType','buyerId','buyerEmail','pointsCost','benefitValue','productId','productName','status','createdAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','storeId','rewardId','rewardTitle','rewardType','buyerId','buyerEmail','pointsCost','benefitValue','productId','productName','status','createdAt','recordedAt','schemaVersion']);
        allow update, delete: if false;
      }

      match /stores/{storeId} {
        function isUserStoreOwner(userId, storeId) {
          return request.auth != null && request.auth.uid == userId && storeId == userId;
        }
        function hasValidUserStoreKeys(data) {
          return data.keys().hasAll(['id','ownerId','ownerEmail','name','slug','description','logo','banner','primaryColor','plan','keywords','offerImages','address','contact','status','createdAt','updatedAt']) && data.keys().hasOnly(['id','ownerId','ownerEmail','name','slug','description','logo','banner','primaryColor','plan','keywords','offerImages','address','contact','status','createdAt','updatedAt','lat','lng']);
        }
        function hasValidUserStoreCoordinates(data) {
          return !data.keys().hasAny(['lat', 'lng']) || (
            data.keys().hasAll(['lat', 'lng']) && data.lat is number && data.lng is number && data.lat >= -90 && data.lat <= 90 && data.lng >= -180 && data.lng <= 180
          );
        }
        function hasValidUserStoreTypes(data) {
          return data.id is string && data.ownerId is string && data.ownerEmail is string && data.name is string && data.slug is string && data.description is string && data.logo is string && data.banner is string && data.primaryColor is string && data.plan is string && data.keywords is list && data.offerImages is list && data.address is string && data.contact is string && data.status is string && data.createdAt is timestamp && data.updatedAt is timestamp && data.plan in ['free', 'pro', 'business'] && data.status in ['open', 'delayed', 'closed'] && hasValidUserStoreCoordinates(data);
        }
        allow get: if isUserStoreOwner(userId, storeId);
        allow list: if false;
        allow create: if isUserStoreOwner(userId, storeId)
          && hasValidUserStoreKeys(request.resource.data)
          && hasValidUserStoreTypes(request.resource.data)
          && request.resource.data.id == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.plan == 'free'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isUserStoreOwner(userId, storeId)
          && resource.data.id == userId
          && resource.data.ownerId == userId
          && hasValidUserStoreKeys(request.resource.data)
          && hasValidUserStoreTypes(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.plan == resource.data.plan
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerEmail','name','slug','description','logo','banner','primaryColor','keywords','offerImages','address','contact','status','lat','lng','updatedAt']);
        allow delete: if false;
      }
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if isSignedIn() && (
        resource != null && 'sharedWith' in resource.data && resource.data.sharedWith is list && request.auth.uid in resource.data.sharedWith
      );
    }

    match /tenants/{tenantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /storeLoyaltyConfigs/{storeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == storeId
        && incoming().storeId == storeId
        && incoming().productPoints is map
        && incoming().updatedAt == request.time
        && incoming().schemaVersion == 2
        && incoming().keys().hasAll(['storeId','productPoints','updatedAt','schemaVersion'])
        && incoming().keys().hasOnly(['storeId','productPoints','updatedAt','schemaVersion']);
      allow delete: if isSignedIn() && (request.auth.uid == storeId || isAdmin());
    }

    match /storeLoyaltyChallenges/{storeId} {
      allow read, write: if false;
      match /items/{challengeId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.auth.uid == storeId
          && isValidId(challengeId)
          && incoming().id == challengeId
          && incoming().storeId == storeId
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 180
          && incoming().description is string
          && incoming().metric in ['paid_orders','points_earned']
          && incoming().target is number
          && incoming().target >= 1
          && incoming().rewardPoints is number
          && incoming().rewardPoints >= 0
          && incoming().startsAt is string
          && incoming().endsAt is string
          && incoming().active is bool
          && incoming().createdAt is string
          && incoming().updatedAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 2
          && incoming().keys().hasAll(['id','storeId','title','description','metric','target','rewardPoints','startsAt','endsAt','active','createdAt','updatedAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','storeId','title','description','metric','target','rewardPoints','startsAt','endsAt','active','createdAt','updatedAt','recordedAt','schemaVersion']);
        allow delete: if isSignedIn() && (request.auth.uid == storeId || isAdmin());
      }
    }

    match /storeLoyaltyRewards/{storeId} {
      allow read, write: if false;
      match /items/{rewardId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.auth.uid == storeId
          && isValidId(rewardId)
          && incoming().id == rewardId
          && incoming().storeId == storeId
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 180
          && incoming().description is string
          && incoming().type in ['discount','free_product','voucher']
          && incoming().pointsCost is number
          && incoming().pointsCost >= 1
          && incoming().benefitValue is number
          && incoming().benefitValue >= 0
          && incoming().productId is string
          && incoming().productName is string
          && incoming().active is bool
          && incoming().startsAt is string
          && incoming().endsAt is string
          && incoming().createdAt is string
          && incoming().updatedAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 2
          && incoming().keys().hasAll(['id','storeId','title','description','type','pointsCost','benefitValue','productId','productName','active','startsAt','endsAt','createdAt','updatedAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','storeId','title','description','type','pointsCost','benefitValue','productId','productName','active','startsAt','endsAt','createdAt','updatedAt','recordedAt','schemaVersion']);
        allow delete: if isSignedIn() && (request.auth.uid == storeId || isAdmin());
      }
    }

    match /storeLoyaltyLedgers/{storeId} {
      allow read, write: if false;
      match /events/{eventId} {
        allow read: if isSignedIn() && (request.auth.uid == storeId || isAdmin());
        allow create: if isSignedIn()
          && isValidLedgerId(eventId)
          && incoming().storeId == storeId
          && incoming().buyerId is string
          && incoming().buyerId.size() > 0
          && incoming().buyerEmail is string
          && incoming().id is string
          && incoming().orderId is string
          && incoming().type in ['earn', 'reversal', 'adjustment']
          && incoming().points is number
          && incoming().reason is string
          && incoming().lines is list
          && incoming().sourceEventId is string
          && incoming().createdAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 2
          && (
            request.auth.uid == storeId ||
            (request.auth.uid == incoming().buyerId && incoming().type == 'adjustment' && incoming().points < 0)
          )
          && incoming().keys().hasAll(['id','storeId','buyerId','buyerEmail','orderId','type','points','reason','lines','sourceEventId','createdAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','storeId','buyerId','buyerEmail','orderId','type','points','reason','lines','sourceEventId','createdAt','recordedAt','schemaVersion']);
        allow update, delete: if false;
      }
    }

    match /storeLoyaltyChallengeCompletions/{storeId} {
      allow read, write: if false;
      match /completions/{completionId} {
        allow read: if isSignedIn() && (request.auth.uid == storeId || isAdmin());
        allow create: if isSignedIn()
          && request.auth.uid == storeId
          && isValidLedgerId(completionId)
          && incoming().id == completionId
          && incoming().storeId == storeId
          && incoming().challengeId is string
          && incoming().challengeTitle is string
          && incoming().buyerId is string
          && incoming().buyerEmail is string
          && incoming().metric in ['paid_orders','points_earned']
          && incoming().achievedValue is number
          && incoming().target is number
          && incoming().rewardPoints is number
          && incoming().completedAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 2
          && incoming().keys().hasAll(['id','storeId','challengeId','challengeTitle','buyerId','buyerEmail','metric','achievedValue','target','rewardPoints','completedAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','storeId','challengeId','challengeTitle','buyerId','buyerEmail','metric','achievedValue','target','rewardPoints','completedAt','recordedAt','schemaVersion']);
        allow update, delete: if false;
      }
    }

    match /storeLoyaltyRewardRedemptions/{storeId} {
      allow read, write: if false;
      match /redemptions/{redemptionId} {
        allow read: if isSignedIn() && (request.auth.uid == storeId || isAdmin());
        allow create: if isSignedIn()
          && isValidLedgerId(redemptionId)
          && incoming().id == redemptionId
          && incoming().storeId == storeId
          && incoming().buyerId == request.auth.uid
          && incoming().rewardId is string
          && incoming().rewardTitle is string
          && incoming().rewardType in ['discount','free_product','voucher']
          && incoming().buyerEmail is string
          && incoming().pointsCost is number
          && incoming().pointsCost > 0
          && incoming().benefitValue is number
          && incoming().productId is string
          && incoming().productName is string
          && incoming().status == 'issued'
          && incoming().createdAt is string
          && incoming().recordedAt == request.time
          && incoming().schemaVersion == 2
          && incoming().keys().hasAll(['id','storeId','rewardId','rewardTitle','rewardType','buyerId','buyerEmail','pointsCost','benefitValue','productId','productName','status','createdAt','recordedAt','schemaVersion'])
          && incoming().keys().hasOnly(['id','storeId','rewardId','rewardTitle','rewardType','buyerId','buyerEmail','pointsCost','benefitValue','productId','productName','status','createdAt','recordedAt','schemaVersion']);
        allow update, delete: if false;
      }
    }

    // Legacy multi-tenant artifacts. This broad rule remains temporarily for modules not yet migrated.
    match /artifacts/{tenantId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      match /{allData=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    match /connections/{connectionId} {
      function hasValidConnectionId() {
        return connectionId.size() > 0 && connectionId.size() <= 128 && connectionId.matches('^[a-zA-Z0-9_-]+$');
      }
      function hasValidParticipants(data) {
        return data.senderId is string && data.receiverId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 && data.receiverId.size() > 0 && data.receiverId.size() <= 128 && data.senderId.matches('^[a-zA-Z0-9_-]+$') && data.receiverId.matches('^[a-zA-Z0-9_-]+$') && data.senderId != data.receiverId && data.participantIds is list && data.participantIds.size() == 2 && data.participantIds.hasAll([data.senderId,data.receiverId]) && (connectionId == data.senderId + '_' + data.receiverId || connectionId == data.receiverId + '_' + data.senderId);
      }
      function hasImmutableParticipants() {
        return incoming().senderId == existing().senderId && incoming().receiverId == existing().receiverId && incoming().participantIds == existing().participantIds;
      }
      allow read: if isSignedIn() && (request.auth.uid in existing().participantIds || isAdmin());
      allow create: if isSignedIn()
        && hasValidConnectionId()
        && hasValidParticipants(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().keys().hasAll(['senderId','receiverId','participantIds','status','createdAt','updatedAt'])
        && incoming().keys().hasOnly(['senderId','receiverId','participantIds','status','senderName','senderRole','senderAvatar','senderBio','receiverName','receiverRole','receiverAvatar','receiverBio','createdAt','updatedAt']);
      allow update: if isSignedIn()
        && request.auth.uid == existing().receiverId
        && existing().status == 'pending'
        && incoming().status == 'accepted'
        && hasImmutableParticipants()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status','acceptedAt','updatedAt'])
        && incoming().createdAt == existing().createdAt
        && incoming().acceptedAt == request.time
        && incoming().updatedAt == request.time
        && incoming().keys().hasOnly(['senderId','receiverId','participantIds','status','senderName','senderRole','senderAvatar','senderBio','receiverName','receiverRole','receiverAvatar','receiverBio','createdAt','acceptedAt','updatedAt']);
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (existing().status == 'pending' && (request.auth.uid == existing().senderId || request.auth.uid == existing().receiverId)) ||
        (existing().status == 'accepted' && request.auth.uid in existing().participantIds)
      );
    }

    match /social_chats/{connectionId} {
      function connectionExists() { return exists(/databases/$(database)/documents/connections/$(connectionId)); }
      function connectionData() { return get(/databases/$(database)/documents/connections/$(connectionId)).data; }
      function canAccessMessages() {
        return isSignedIn() && isValidId(connectionId) && connectionExists() && connectionData().status == 'accepted' && request.auth.uid in connectionData().participantIds;
      }
      function hasValidReceiver() {
        return (request.auth.uid == connectionData().senderId && incoming().receiverId == connectionData().receiverId) || (request.auth.uid == connectionData().receiverId && incoming().receiverId == connectionData().senderId);
      }
      allow read, write: if false;
      match /messages/{messageId} {
        allow get: if canAccessMessages() && isValidId(messageId);
        allow list: if canAccessMessages() && request.query.limit <= 100;
        allow create: if canAccessMessages()
          && isValidId(messageId)
          && incoming().keys().hasAll(['senderId','receiverId','text','createdAt'])
          && incoming().keys().hasOnly(['senderId','receiverId','text','createdAt'])
          && incoming().senderId == request.auth.uid
          && isValidId(incoming().senderId)
          && isValidId(incoming().receiverId)
          && hasValidReceiver()
          && incoming().text is string
          && incoming().text.size() >= 1
          && incoming().text.size() <= 4000
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || incoming().keys().hasOnly(['likes']) || isAdmin());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /hub/renda/deliveries/{deliveryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /vagas/{vagaId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || hasRole(['owner', 'manager', 'staff']);
    }

    match /candidaturas/{candiId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn();
    }

    match /artifacts { allow list: if isSignedIn(); }
    match /tenants { allow list: if isSignedIn(); }
  }
}
