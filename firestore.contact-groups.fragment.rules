    // --- Private Contact Groups ---
    match /users/{userId}/contact_groups/{groupId} {
      function hasValidContactGroupShape(data) {
        return data.keys().hasAll([
          'groupId',
          'ownerId',
          'name',
          'memberIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'groupId',
          'ownerId',
          'name',
          'memberIds',
          'createdAt',
          'updatedAt'
        ])
        && data.groupId == groupId
        && data.ownerId == userId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.memberIds is list
        && data.memberIds.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
      }

      allow read: if isSignedIn()
        && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidContactGroupShape(incoming());

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid
        && incoming().groupId == existing().groupId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'memberIds',
          'updatedAt'
        ])
        && hasValidContactGroupShape(incoming());

      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid;
    }

    // Private contact favorites, independent from public posts and stores.
    match /users/{userId}/contact_favorites/{contactId} {
      function owner() { return isSignedIn() && request.auth.uid == userId; }
      function validFavorite() {
        let data = incoming();
        let connection = get(/databases/$(database)/documents/connections/$(data.connectionId)).data;
        return isValidId(contactId) && contactId != userId
          && isValidId(data.connectionId)
          && data.keys().hasOnly(['connectionId','favorited','updatedAt'])
          && data.favorited == true && data.updatedAt == request.time
          && connection.status == 'accepted'
          && ((connection.senderId == userId && connection.receiverId == contactId)
            || (connection.receiverId == userId && connection.senderId == contactId));
      }
      allow read, delete: if owner();
      allow create, update: if owner() && validFavorite();
    }
