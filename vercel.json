{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/check-vercel-function-budget.mjs && npm run build --ignore-scripts && node scripts/normalize-serverless-esm-imports.mjs && npm run lint",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "preview-*": true,
      "feat/profile-react-rebuild": true
    }
  },
  "functions": {
    "api/mercado-livre-orders-v2-consumer.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "mercado_livre_orders_v2",
          "retryAfterSeconds": 30,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/action-execute",
      "has": [
        {
          "type": "query",
          "key": "transport",
          "value": "kyrubia-user-ai-chat"
        }
      ],
      "destination": "/api/health?transport=kyrubia-user-ai-chat"
    },
    {
      "source": "/api/store-connections/:path*",
      "destination": "/api/health?transport=store-connections&path=:path*"
    },
    {
      "source": "/api/store-crm",
      "destination": "/api/health?transport=store-crm"
    },
    {
      "source": "/api/local-attendance",
      "destination": "/api/health?transport=local-attendance"
    },
    {
      "source": "/api/local-attendance/:path*",
      "destination": "/api/health?transport=local-attendance&path=:path*"
    },
    {
      "source": "/api/store-promotions",
      "destination": "/api/health?transport=store-promotions"
    },
    {
      "source": "/api/store-promotions/:path*",
      "destination": "/api/health?transport=store-promotions&path=:path*"
    },
    {
      "source": "/api/store-finance",
      "destination": "/api/health?transport=store-promotions&surface=finance"
    },
    {
      "source": "/api/store-payroll",
      "destination": "/api/health?transport=store-promotions&surface=payroll"
    },
    {
      "source": "/api/store-sales-analytics",
      "destination": "/api/health?transport=store-promotions&surface=sales-analytics"
    },
    {
      "source": "/api/marketplace-discovery/public/:slug",
      "destination": "/api/health?transport=public-storefront&slug=:slug"
    },
    {
      "source": "/api/orders/:orderId/attendance-review",
      "destination": "/api/health?transport=local-attendance&path=orders/:orderId/attendance-review"
    },
    {
      "source": "/api/media/drive",
      "destination": "/api/health?transport=drive-media"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/health?transport=mcp"
    },
    {
      "source": "/api/kyrubia-bridge/:path*",
      "destination": "/api/health?transport=kyrubia-bridge&path=:path*"
    },
    {
      "source": "/api/orders/:orderId/status",
      "destination": "/api/health?transport=order-status-execute&orderId=:orderId"
    },
    {
      "source": "/api/payments/maintenance/expire",
      "destination": "/api/action-execute?transport=marketplace-payment-expiry"
    },
    {
      "source": "/api/payments/intents",
      "destination": "/api/action-execute?transport=marketplace-payment-intent"
    },
    {
      "source": "/api/payments/promotions",
      "destination": "/api/action-execute?transport=marketplace-promotions"
    },
    {
      "source": "/api/payments/coupons/quote",
      "destination": "/api/action-execute?transport=marketplace-coupon-quote"
    },
    {
      "source": "/api/payments/webhooks/mercado-pago",
      "destination": "/api/action-execute?transport=mercado-pago-webhook"
    },
    {
      "source": "/api/admin/integrations/mercado-livre/status",
      "destination": "/api/admin/operations/health?transport=mercado-livre-platform-status"
    },
    {
      "source": "/api/admin/integrations/mercado-livre/credentials",
      "destination": "/api/admin/operations/health?transport=mercado-livre-platform-credentials"
    },
    {
      "source": "/api/admin/integrations/mercado-livre/validate",
      "destination": "/api/admin/operations/health?transport=mercado-livre-platform-validate"
    },
    {
      "source": "/api/admin/integrations/status",
      "destination": "/api/admin/operations/health?transport=integration-readiness"
    },
    {
      "source": "/api/admin/platform-economy",
      "destination": "/api/admin/operations/health?transport=platform-economy"
    },
    {
      "source": "/api/admin/store-entitlements/promotional-pro",
      "destination": "/api/admin/operations/health?transport=promotional-pro"
    },
    {
      "source": "/staff",
      "destination": "/index.html"
    },
    {
      "source": "/staff/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:slug/staff",
      "destination": "/index.html"
    }
  ]
}
