{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "codex/*": false,
      "preview-*": true
    }
  },
  "rewrites": [
    {
      "source": "/api/mcp",
      "destination": "/api/health?transport=mcp"
    },
    {
      "source": "/api/payments/intents",
      "destination": "/api/action-execute?transport=marketplace-payment-intent"
    },
    {
      "source": "/api/payments/promotions",
      "destination": "/api/action-execute?transport=marketplace-promotions"
    },
    {
      "source": "/api/payments/coupons/quote",
      "destination": "/api/action-execute?transport=marketplace-coupon-quote"
    },
    {
      "source": "/api/payments/webhooks/mercado-pago",
      "destination": "/api/action-execute?transport=mercado-pago-webhook"
    },
    {
      "source": "/api/admin/integrations/status",
      "destination": "/api/admin/operations/health?transport=integration-readiness"
    },
    {
      "source": "/staff",
      "destination": "/index.html"
    },
    {
      "source": "/staff/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:slug/staff",
      "destination": "/index.html"
    }
  ]
}
