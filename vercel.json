{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/normalize-serverless-esm-imports.mjs && npm run lint",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "codex/*": false,
      "preview-*": true
    }
  },
  "rewrites": [
    {
      "source": "/api/store-connections/mercado-livre/callback",
      "destination": "/api/health?transport=store-connections&path=mercado-livre/callback"
    },
    {
      "source": "/api/store-connections/mercado-livre/notifications",
      "destination": "/api/health?transport=store-connections&path=mercado-livre/notifications"
    },
    {
      "source": "/api/store-connections/mercado-livre/:storeId/:segment1",
      "destination": "/api/health?transport=store-connections&path=mercado-livre/:storeId/:segment1"
    },
    {
      "source": "/api/store-connections/mercado-livre/:storeId/:segment1/:segment2",
      "destination": "/api/health?transport=store-connections&path=mercado-livre/:storeId/:segment1/:segment2"
    },
    {
      "source": "/api/store-connections/mercado-livre/:storeId/:segment1/:segment2/:segment3",
      "destination": "/api/health?transport=store-connections&path=mercado-livre/:storeId/:segment1/:segment2/:segment3"
    },
    {
      "source": "/api/store-connections/mercado-livre/:storeId/:segment1/:segment2/:segment3/:segment4",
      "destination": "/api/health?transport=store-connections&path=mercado-livre/:storeId/:segment1/:segment2/:segment3/:segment4"
    },
    {
      "source": "/api/store-connections/:storeId",
      "destination": "/api/health?transport=store-connections&path=:storeId"
    },
    {
      "source": "/api/store-connections/:storeId/:segment1",
      "destination": "/api/health?transport=store-connections&path=:storeId/:segment1"
    },
    {
      "source": "/api/store-connections/:storeId/:segment1/:segment2",
      "destination": "/api/health?transport=store-connections&path=:storeId/:segment1/:segment2"
    },
    {
      "source": "/api/store-connections/:path*",
      "destination": "/api/health?transport=store-connections&path=:path*"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/health?transport=mcp"
    },
    {
      "source": "/api/orders/:orderId/status",
      "destination": "/api/health?transport=order-status-execute&orderId=:orderId"
    },
    {
      "source": "/api/payments/intents",
      "destination": "/api/action-execute?transport=marketplace-payment-intent"
    },
    {
      "source": "/api/payments/promotions",
      "destination": "/api/action-execute?transport=marketplace-promotions"
    },
    {
      "source": "/api/payments/coupons/quote",
      "destination": "/api/action-execute?transport=marketplace-coupon-quote"
    },
    {
      "source": "/api/payments/webhooks/mercado-pago",
      "destination": "/api/action-execute?transport=mercado-pago-webhook"
    },
    {
      "source": "/api/admin/integrations/status",
      "destination": "/api/admin/operations/health?transport=integration-readiness"
    },
    {
      "source": "/api/admin/platform-economy",
      "destination": "/api/admin/operations/health?transport=platform-economy"
    },
    {
      "source": "/staff",
      "destination": "/index.html"
    },
    {
      "source": "/staff/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:slug/staff",
      "destination": "/index.html"
    }
  ]
}
