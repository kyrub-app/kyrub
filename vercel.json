{
  "rewrites": [
    {
      "source": "/api/mcp",
      "destination": "/api/health?transport=mcp"
    },
    {
      "source": "/staff",
      "destination": "/index.html"
    },
    {
      "source": "/staff/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:slug/staff",
      "destination": "/index.html"
    }
  ]
}
