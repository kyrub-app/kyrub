{
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/staff",
      "destination": "/index.html"
    }
  ]
}
