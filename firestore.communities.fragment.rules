    // --- Kyrub Communities, Memberships and Mural Interactions ---
    function communityDocumentPath(communityId) {
      return /databases/$(database)/documents/communities/$(communityId);
    }

    function communityMembershipDocumentId(communityId, userId) {
      return communityId + '__' + userId;
    }

    function communityMembershipDocumentPath(communityId, userId) {
      return /databases/$(database)/documents/community_members/$(communityMembershipDocumentId(communityId, userId));
    }

    function communityExists(communityId) {
      return exists(communityDocumentPath(communityId));
    }

    function isCommunityOwner(communityId) {
      return isSignedIn()
        && communityExists(communityId)
        && get(communityDocumentPath(communityId)).data.ownerId == request.auth.uid;
    }

    function hasCommunityMembership(communityId) {
      return isSignedIn()
        && exists(communityMembershipDocumentPath(communityId, request.auth.uid));
    }

    function isActiveCommunityMember(communityId) {
      return hasCommunityMembership(communityId)
        && get(communityMembershipDocumentPath(communityId, request.auth.uid)).data.status == 'active';
    }

    function canReadCommunity(communityId) {
      return isSignedIn()
        && communityExists(communityId)
        && (
          get(communityDocumentPath(communityId)).data.visibility in ['public', 'moderated']
          || get(communityDocumentPath(communityId)).data.ownerId == request.auth.uid
          || hasCommunityMembership(communityId)
        );
    }

    function hasValidCommunityShape(data, communityId) {
      return data.keys().hasAll([
        'communityId',
        'ownerId',
        'ownerName',
        'ownerAvatar',
        'name',
        'description',
        'category',
        'location',
        'visibility',
        'rules',
        'coverImage',
        'coverPath',
        'memberCount',
        'lastMembershipChangeId',
        'createdAtIso',
        'createdAt',
        'updatedAtIso',
        'updatedAt',
        'activityAtIso',
        'activityAt'
      ])
      && data.keys().hasOnly([
        'communityId',
        'ownerId',
        'ownerName',
        'ownerAvatar',
        'name',
        'description',
        'category',
        'location',
        'visibility',
        'rules',
        'coverImage',
        'coverPath',
        'memberCount',
        'lastMembershipChangeId',
        'createdAtIso',
        'createdAt',
        'updatedAtIso',
        'updatedAt',
        'activityAtIso',
        'activityAt'
      ])
      && data.communityId == communityId
      && data.ownerId is string
      && data.ownerId.size() > 0
      && data.ownerId.size() <= 128
      && data.ownerName is string
      && data.ownerName.size() > 0
      && data.ownerName.size() <= 160
      && data.ownerAvatar is string
      && data.ownerAvatar.size() <= 4096
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 80
      && data.description is string
      && data.description.size() > 0
      && data.description.size() <= 500
      && data.category is string
      && data.category.size() > 0
      && data.category.size() <= 80
      && data.location is string
      && data.location.size() <= 120
      && data.visibility in ['public', 'moderated', 'private']
      && data.rules is string
      && data.rules.size() > 0
      && data.rules.size() <= 1200
      && data.coverImage is string
      && data.coverImage.size() <= 4096
      && data.coverPath is string
      && data.coverPath.size() <= 1024
      && data.memberCount is int
      && data.memberCount >= 1
      && data.memberCount <= 1000000000
      && data.lastMembershipChangeId is string
      && data.lastMembershipChangeId.size() > 0
      && data.lastMembershipChangeId.size() <= 500
      && data.createdAtIso is string
      && data.createdAtIso.size() <= 64
      && data.createdAt is timestamp
      && data.updatedAtIso is string
      && data.updatedAtIso.size() <= 64
      && data.updatedAt is timestamp
      && data.activityAtIso is string
      && data.activityAtIso.size() <= 64
      && data.activityAt is timestamp;
    }

    match /communities/{communityId} {
      allow read: if isSignedIn()
        && (
          existing().visibility in ['public', 'moderated']
          || existing().ownerId == request.auth.uid
          || hasCommunityMembership(communityId)
        );

      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().memberCount == 1
        && incoming().lastMembershipChangeId
          == communityMembershipDocumentId(communityId, request.auth.uid)
        && incoming().coverImage == ''
        && incoming().coverPath == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().activityAt == request.time
        && hasValidCommunityShape(incoming(), communityId)
        && existsAfter(
          communityMembershipDocumentPath(communityId, request.auth.uid)
        )
        && getAfter(
          communityMembershipDocumentPath(communityId, request.auth.uid)
        ).data.userId == request.auth.uid
        && getAfter(
          communityMembershipDocumentPath(communityId, request.auth.uid)
        ).data.communityId == communityId
        && getAfter(
          communityMembershipDocumentPath(communityId, request.auth.uid)
        ).data.role == 'owner'
        && getAfter(
          communityMembershipDocumentPath(communityId, request.auth.uid)
        ).data.status == 'active';

      allow update: if isSignedIn()
        && existing().ownerId == request.auth.uid
        && incoming().communityId == existing().communityId
        && incoming().ownerId == existing().ownerId
        && incoming().ownerName == existing().ownerName
        && incoming().ownerAvatar == existing().ownerAvatar
        && incoming().visibility == existing().visibility
        && incoming().memberCount == existing().memberCount
        && incoming().lastMembershipChangeId == existing().lastMembershipChangeId
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().activityAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'description',
          'category',
          'location',
          'rules',
          'coverImage',
          'coverPath',
          'updatedAtIso',
          'updatedAt',
          'activityAtIso',
          'activityAt'
        ])
        && hasValidCommunityShape(incoming(), communityId);

      allow update: if isSignedIn()
        && incoming().communityId == existing().communityId
        && incoming().ownerId == existing().ownerId
        && incoming().ownerName == existing().ownerName
        && incoming().ownerAvatar == existing().ownerAvatar
        && incoming().name == existing().name
        && incoming().description == existing().description
        && incoming().category == existing().category
        && incoming().location == existing().location
        && incoming().visibility == existing().visibility
        && incoming().rules == existing().rules
        && incoming().coverImage == existing().coverImage
        && incoming().coverPath == existing().coverPath
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().activityAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'memberCount',
          'lastMembershipChangeId',
          'updatedAtIso',
          'updatedAt',
          'activityAtIso',
          'activityAt'
        ])
        && hasValidCommunityShape(incoming(), communityId)
        && (
          (
            incoming().memberCount == existing().memberCount + 1
            && existsAfter(
              /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
            )
            && getAfter(
              /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
            ).data.communityId == communityId
            && getAfter(
              /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
            ).data.status == 'active'
            && (
              !exists(
                /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
              )
              || get(
                /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
              ).data.status != 'active'
            )
            && (
              getAfter(
                /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
              ).data.userId == request.auth.uid
              || existing().ownerId == request.auth.uid
            )
          )
          || (
            incoming().memberCount == existing().memberCount - 1
            && existing().memberCount > 1
            && exists(
              /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
            )
            && get(
              /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
            ).data.communityId == communityId
            && get(
              /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
            ).data.status == 'active'
            && (
              !existsAfter(
                /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
              )
              || getAfter(
                /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
              ).data.status != 'active'
            )
            && (
              get(
                /databases/$(database)/documents/community_members/$(incoming().lastMembershipChangeId)
              ).data.userId == request.auth.uid
              || existing().ownerId == request.auth.uid
            )
          )
        );

      allow delete: if false;
    }

    function hasValidCommunityMembershipShape(data, membershipId) {
      return data.keys().hasAll([
        'membershipId',
        'communityId',
        'userId',
        'userName',
        'userAvatar',
        'role',
        'status',
        'joinedAtIso',
        'joinedAt',
        'updatedAtIso',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'membershipId',
        'communityId',
        'userId',
        'userName',
        'userAvatar',
        'role',
        'status',
        'joinedAtIso',
        'joinedAt',
        'updatedAtIso',
        'updatedAt'
      ])
      && data.membershipId == membershipId
      && membershipId == data.communityId + '__' + data.userId
      && data.communityId is string
      && data.communityId.size() > 0
      && data.communityId.size() <= 128
      && data.userId is string
      && data.userId.size() > 0
      && data.userId.size() <= 128
      && data.userName is string
      && data.userName.size() > 0
      && data.userName.size() <= 160
      && data.userAvatar is string
      && data.userAvatar.size() <= 4096
      && data.role in ['owner', 'moderator', 'member']
      && data.status in ['active', 'pending']
      && data.joinedAtIso is string
      && data.joinedAtIso.size() <= 64
      && data.joinedAt is timestamp
      && data.updatedAtIso is string
      && data.updatedAtIso.size() <= 64
      && data.updatedAt is timestamp;
    }

    match /community_members/{membershipId} {
      // A new participant may read their own missing deterministic membership
      // document before it is created in the same join transaction.
      allow get: if isSignedIn()
        && (
          (resource == null
            && membershipId.matches('^.+__' + request.auth.uid + '$'))
          || (resource != null && (
            existing().userId == request.auth.uid
            || isCommunityOwner(existing().communityId)
            || (
              existing().status == 'active'
              && canReadCommunity(existing().communityId)
            )
          ))
        );

      // A visitor cannot list every request awaiting approval; owner-only
      // administration retains the full list. Active members are readable.
      allow list: if isSignedIn()
        && (
          existing().userId == request.auth.uid
          || isCommunityOwner(existing().communityId)
          || (
            existing().status == 'active'
            && canReadCommunity(existing().communityId)
          )
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().joinedAt == request.time
        && incoming().updatedAt == request.time
        && hasValidCommunityMembershipShape(incoming(), membershipId)
        && existsAfter(communityDocumentPath(incoming().communityId))
        && (
          (
            incoming().role == 'owner'
            && incoming().status == 'active'
            && !communityExists(incoming().communityId)
            && getAfter(communityDocumentPath(incoming().communityId)).data.ownerId
              == request.auth.uid
            && getAfter(communityDocumentPath(incoming().communityId)).data.memberCount
              == 1
            && getAfter(communityDocumentPath(incoming().communityId)).data.lastMembershipChangeId
              == membershipId
          )
          || (
            incoming().role == 'member'
            && communityExists(incoming().communityId)
            && get(communityDocumentPath(incoming().communityId)).data.visibility
              == 'public'
            && incoming().status == 'active'
            && getAfter(communityDocumentPath(incoming().communityId)).data.memberCount
              == get(communityDocumentPath(incoming().communityId)).data.memberCount + 1
            && getAfter(communityDocumentPath(incoming().communityId)).data.lastMembershipChangeId
              == membershipId
          )
          || (
            incoming().role == 'member'
            && communityExists(incoming().communityId)
            && get(communityDocumentPath(incoming().communityId)).data.visibility
              == 'moderated'
            && incoming().status == 'pending'
          )
        );

      allow update: if isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().membershipId == existing().membershipId
        && incoming().communityId == existing().communityId
        && incoming().userId == existing().userId
        && incoming().role == existing().role
        && incoming().status == existing().status
        && incoming().joinedAtIso == existing().joinedAtIso
        && incoming().joinedAt == existing().joinedAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'userName',
          'userAvatar',
          'updatedAtIso',
          'updatedAt'
        ])
        && hasValidCommunityMembershipShape(incoming(), membershipId);

      allow update: if isCommunityOwner(existing().communityId)
        && existing().role == 'member'
        && existing().status == 'pending'
        && incoming().membershipId == existing().membershipId
        && incoming().communityId == existing().communityId
        && incoming().userId == existing().userId
        && incoming().userName == existing().userName
        && incoming().userAvatar == existing().userAvatar
        && incoming().role == existing().role
        && incoming().status == 'active'
        && incoming().joinedAtIso == existing().joinedAtIso
        && incoming().joinedAt == existing().joinedAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'updatedAtIso',
          'updatedAt'
        ])
        && hasValidCommunityMembershipShape(incoming(), membershipId)
        && getAfter(communityDocumentPath(existing().communityId)).data.memberCount
          == get(communityDocumentPath(existing().communityId)).data.memberCount + 1
        && getAfter(communityDocumentPath(existing().communityId)).data.lastMembershipChangeId
          == membershipId;

      allow delete: if isSignedIn()
        && existing().role != 'owner'
        && (
          existing().userId == request.auth.uid
          || isCommunityOwner(existing().communityId)
        )
        && (
          existing().status == 'pending'
          || (
            existing().status == 'active'
            && getAfter(communityDocumentPath(existing().communityId)).data.memberCount
              == get(communityDocumentPath(existing().communityId)).data.memberCount - 1
            && getAfter(communityDocumentPath(existing().communityId)).data.lastMembershipChangeId
              == membershipId
          )
        );
    }

    function hasValidCommunityPostShape(data, postId) {
      return data.keys().hasAll([
        'postId',
        'communityId',
        'authorId',
        'authorName',
        'authorAvatar',
        'content',
        'mediaUrls',
        'createdAtIso',
        'createdAt',
        'updatedAtIso',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'postId',
        'communityId',
        'authorId',
        'authorName',
        'authorAvatar',
        'content',
        'mediaUrls',
        'createdAtIso',
        'createdAt',
        'updatedAtIso',
        'updatedAt'
      ])
      && data.postId == postId
      && data.communityId is string
      && data.communityId.size() > 0
      && data.communityId.size() <= 128
      && data.authorId is string
      && data.authorId.size() > 0
      && data.authorId.size() <= 128
      && data.authorName is string
      && data.authorName.size() > 0
      && data.authorName.size() <= 160
      && data.authorAvatar is string
      && data.authorAvatar.size() <= 4096
      && data.content is string
      && data.content.size() <= 3000
      && data.mediaUrls is list
      && data.mediaUrls.size() <= 9
      && (data.content.size() > 0 || data.mediaUrls.size() > 0)
      && data.createdAtIso is string
      && data.createdAtIso.size() <= 64
      && data.createdAt is timestamp
      && data.updatedAtIso is string
      && data.updatedAtIso.size() <= 64
      && data.updatedAt is timestamp;
    }

    match /community_posts/{postId} {
      allow read: if canReadCommunity(existing().communityId);

      allow create: if isSignedIn()
        && incoming().authorId == request.auth.uid
        && isActiveCommunityMember(incoming().communityId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidCommunityPostShape(incoming(), postId);

      allow update: if isSignedIn()
        && existing().authorId == request.auth.uid
        && incoming().postId == existing().postId
        && incoming().communityId == existing().communityId
        && incoming().authorId == existing().authorId
        && incoming().authorName == existing().authorName
        && incoming().authorAvatar == existing().authorAvatar
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'content',
          'mediaUrls',
          'updatedAtIso',
          'updatedAt'
        ])
        && hasValidCommunityPostShape(incoming(), postId);

      allow delete: if isSignedIn()
        && (
          existing().authorId == request.auth.uid
          || isCommunityOwner(existing().communityId)
        );
    }


    // Praça discovery stores only a pointer. The full post always comes from
    // community_posts and remains subject to community visibility rules.
    match /community_square_posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && incoming().keys().hasAll(['postId', 'communityId', 'createdAt'])
        && incoming().keys().hasOnly(['postId', 'communityId', 'createdAt'])
        && incoming().postId == postId
        && incoming().postId is string
        && incoming().postId.size() > 0
        && incoming().postId.size() <= 128
        && incoming().communityId is string
        && incoming().communityId.size() > 0
        && incoming().communityId.size() <= 128
        && incoming().createdAt is timestamp
        && existsAfter(/databases/$(database)/documents/community_posts/$(postId))
        && getAfter(/databases/$(database)/documents/community_posts/$(postId)).data.authorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/community_posts/$(postId)).data.communityId == incoming().communityId
        && getAfter(/databases/$(database)/documents/community_posts/$(postId)).data.createdAt == incoming().createdAt
        && exists(/databases/$(database)/documents/communities/$(incoming().communityId))
        && get(/databases/$(database)/documents/communities/$(incoming().communityId)).data.visibility == 'public';

      allow update: if false;
      allow delete: if isSignedIn()
        && exists(/databases/$(database)/documents/community_posts/$(postId))
        && get(/databases/$(database)/documents/community_posts/$(postId)).data.authorId == request.auth.uid;
    }

    // In-app forward is an immutable reference to the original public post.
    // One record per actor/post may refresh only once every 24 hours.
    // Never copy media, content or private community material into the index.
    match /community_square_forwards/{forwardId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'postId', 'communityId', 'actorId', 'actorName', 'forwardedAt'
        ])
        && incoming().keys().hasOnly([
          'postId', 'communityId', 'actorId', 'actorName', 'forwardedAt'
        ])
        && incoming().postId is string
        && incoming().communityId is string
        && incoming().actorId == request.auth.uid
        && incoming().actorName is string
        && incoming().actorName.size() > 0
        && incoming().actorName.size() <= 160
        && forwardId == incoming().postId + '__' + request.auth.uid
        && incoming().forwardedAt == request.time
        && exists(/databases/$(database)/documents/community_posts/$(incoming().postId))
        && get(/databases/$(database)/documents/community_posts/$(incoming().postId)).data.communityId
          == incoming().communityId
        && exists(/databases/$(database)/documents/communities/$(incoming().communityId))
        && get(/databases/$(database)/documents/communities/$(incoming().communityId)).data.visibility
          == 'public';

      allow update: if isSignedIn()
        && existing().actorId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['forwardedAt'])
        && incoming().forwardedAt == request.time
        && existing().forwardedAt is timestamp
        && request.time >= existing().forwardedAt + duration.value(24, 'h')
        && exists(/databases/$(database)/documents/community_posts/$(existing().postId))
        && get(/databases/$(database)/documents/community_posts/$(existing().postId)).data.communityId
          == existing().communityId
        && exists(/databases/$(database)/documents/communities/$(existing().communityId))
        && get(/databases/$(database)/documents/communities/$(existing().communityId)).data.visibility
          == 'public';

      allow delete: if isSignedIn() && existing().actorId == request.auth.uid;
    }

    // One private-forward receipt per post, sender and destination person.
    // The actual DM and its cooldown marker must arrive in the SAME transaction.
    match /community_direct_forward_receipts/{receiptId} {
      function validForwardDestination(data) {
        return data.postId is string
          && data.postId.size() > 0 && data.postId.size() <= 128
          && data.communityId is string
          && data.communityId.size() > 0 && data.communityId.size() <= 128
          && data.receiverId is string
          && data.receiverId.size() > 0 && data.receiverId.size() <= 128
          && data.connectionId is string
          && data.connectionId.size() > 0 && data.connectionId.size() <= 128
          && data.messageId is string
          && data.messageId.size() > 0 && data.messageId.size() <= 128
          && data.actorId == request.auth.uid
          && data.receiverId != request.auth.uid
          && receiptId == data.postId + '__' + request.auth.uid + '__' + data.receiverId
          && exists(/databases/$(database)/documents/community_posts/$(data.postId))
          && get(/databases/$(database)/documents/community_posts/$(data.postId)).data.communityId == data.communityId
          && exists(/databases/$(database)/documents/communities/$(data.communityId))
          && get(/databases/$(database)/documents/communities/$(data.communityId)).data.visibility == 'public'
          && exists(/databases/$(database)/documents/connections/$(data.connectionId))
          && get(/databases/$(database)/documents/connections/$(data.connectionId)).data.status == 'accepted'
          && request.auth.uid in get(/databases/$(database)/documents/connections/$(data.connectionId)).data.participantIds
          && data.receiverId in get(/databases/$(database)/documents/connections/$(data.connectionId)).data.participantIds
          && existsAfter(/databases/$(database)/documents/social_chats/$(data.connectionId)/messages/$(data.messageId))
          && getAfter(/databases/$(database)/documents/social_chats/$(data.connectionId)/messages/$(data.messageId)).data.senderId == request.auth.uid
          && getAfter(/databases/$(database)/documents/social_chats/$(data.connectionId)/messages/$(data.messageId)).data.receiverId == data.receiverId
          && getAfter(/databases/$(database)/documents/social_chats/$(data.connectionId)/messages/$(data.messageId)).data.createdAt == request.time;
      }

      allow get: if isSignedIn()
        && ((resource == null && receiptId.matches('^.+__' + request.auth.uid + '__.+$'))
          || (resource != null && existing().actorId == request.auth.uid));
      allow list: if false;

      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'postId', 'communityId', 'actorId', 'receiverId', 'connectionId', 'messageId', 'forwardedAt'
        ])
        && incoming().keys().hasOnly([
          'postId', 'communityId', 'actorId', 'receiverId', 'connectionId', 'messageId', 'forwardedAt'
        ])
        && incoming().forwardedAt == request.time
        && validForwardDestination(incoming());

      allow update: if isSignedIn()
        && existing().actorId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['messageId', 'forwardedAt'])
        && incoming().messageId != existing().messageId
        && incoming().forwardedAt == request.time
        && existing().forwardedAt is timestamp
        && request.time >= existing().forwardedAt + duration.value(24, 'h')
        && validForwardDestination(incoming());

      allow delete: if false;
    }

    // Wall interactions are independently scoped to the existing community and post.
    // They never grant access to a private community or allow likes for strangers.
    function communityPostBelongsTo(postId, communityId) {
      return postId is string
        && postId.size() > 0
        && postId.size() <= 128
        && communityId is string
        && communityId.size() > 0
        && communityId.size() <= 128
        && exists(/databases/$(database)/documents/community_posts/$(postId))
        && get(/databases/$(database)/documents/community_posts/$(postId)).data.communityId == communityId;
    }


    // Organic publication events mirror social_post_engagements in Praça.
    // Clients may only register their own completed actions. Authors (and the
    // actor) can read receipts; unrelated users cannot inspect engagement data.
    match /community_post_engagements/{engagementId} {
      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'engagementId', 'communityId', 'postId', 'postAuthorId',
          'actorId', 'type', 'createdAt'
        ])
        && incoming().keys().hasOnly([
          'engagementId', 'communityId', 'postId', 'postAuthorId',
          'actorId', 'type', 'createdAt'
        ])
        && incoming().engagementId == engagementId
        && incoming().actorId == request.auth.uid
        && incoming().postAuthorId is string
        && incoming().postAuthorId.size() > 0
        && incoming().postAuthorId.size() <= 128
        && incoming().type in ['view', 'save', 'share']
        && incoming().createdAt == request.time
        && communityPostBelongsTo(incoming().postId, incoming().communityId)
        && get(/databases/$(database)/documents/community_posts/$(incoming().postId)).data.authorId
          == incoming().postAuthorId
        && canReadCommunity(incoming().communityId)
        && (
          incoming().type == 'share'
          || engagementId == incoming().postId + '__' + incoming().type + '__' + request.auth.uid
        );

      // Own view/save receipts can be checked before first creation.
      // Existing records are only visible to the actor, author or admin.
      allow get: if isSignedIn()
        && (
          (resource != null
            && (existing().actorId == request.auth.uid
              || existing().postAuthorId == request.auth.uid
              || isAdmin()))
          || (resource == null
            && engagementId.matches('^.+__(view|save)__' + request.auth.uid + '$'))
        );

      allow list: if isSignedIn()
        && (existing().actorId == request.auth.uid
          || existing().postAuthorId == request.auth.uid
          || isAdmin());

      allow update: if false;
      allow delete: if isSignedIn()
        && existing().type == 'save'
        && existing().actorId == request.auth.uid;
    }

    match /community_post_likes/{likeId} {
      allow read: if canReadCommunity(existing().communityId);

      allow create: if isSignedIn()
        && incoming().keys().hasAll(['postId','communityId','userId','createdAt'])
        && incoming().keys().hasOnly(['postId','communityId','userId','createdAt'])
        && incoming().userId == request.auth.uid
        && likeId == incoming().postId + '__' + request.auth.uid
        && incoming().createdAt == request.time
        && communityPostBelongsTo(incoming().postId, incoming().communityId)
        && isActiveCommunityMember(incoming().communityId);

      allow update: if false;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /community_post_comments/{commentId} {
      allow read: if canReadCommunity(existing().communityId);

      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'commentId','communityId','postId','authorId','authorName',
          'authorAvatar','text','createdAtIso','createdAt'
        ])
        && incoming().keys().hasOnly([
          'commentId','communityId','postId','authorId','authorName',
          'authorAvatar','text','createdAtIso','createdAt'
        ])
        && incoming().commentId == commentId
        && incoming().authorId == request.auth.uid
        && incoming().authorName is string
        && incoming().authorName.size() > 0
        && incoming().authorName.size() <= 160
        && incoming().authorAvatar is string
        && incoming().authorAvatar.size() <= 2048
        && incoming().text is string
        && incoming().text.size() > 0
        && incoming().text.size() <= 1000
        && incoming().createdAtIso is string
        && incoming().createdAtIso.size() <= 64
        && incoming().createdAt == request.time
        && communityPostBelongsTo(incoming().postId, incoming().communityId)
        && isActiveCommunityMember(incoming().communityId);

      allow update: if false;
      allow delete: if isSignedIn()
        && (existing().authorId == request.auth.uid
          || isCommunityOwner(existing().communityId));
    }

    // One immutable complaint per reporter and community post; never auto-punish.
    match /community_post_reports/{reportId} {
      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'reportId','communityId','postId','reporterId','authorId',
          'reason','status','createdAt'
        ])
        && incoming().keys().hasOnly([
          'reportId','communityId','postId','reporterId','authorId',
          'reason','status','createdAt'
        ])
        && incoming().reportId == reportId
        && incoming().reporterId == request.auth.uid
        && reportId == incoming().postId + '__' + request.auth.uid
        && incoming().authorId is string
        && incoming().authorId != request.auth.uid
        && incoming().reason in ['spam','abuse','fraud','unsafe','other']
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && communityPostBelongsTo(incoming().postId, incoming().communityId)
        && get(/databases/$(database)/documents/community_posts/$(incoming().postId)).data.authorId == incoming().authorId
        && canReadCommunity(incoming().communityId);

      allow read: if isSignedIn()
        && (existing().reporterId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Debate creation was retired: all conversations now belong to mural posts.
    // Keep historical records readable under their existing privacy rules.
    // Never delete or rewrite archived debate/comment data during retirement.
    match /community_debates/{debateId} {
      allow read: if canReadCommunity(existing().communityId);
      allow create, update, delete: if false;
    }

    match /community_debate_comments/{commentId} {
      allow read: if canReadCommunity(existing().communityId);
      allow create, update, delete: if false;
    }
