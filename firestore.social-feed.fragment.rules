    // --- Public Social Feed, Connection Status, Likes, Comments and Reports ---
    match /social_posts/{postId} {
      function validStoreCouponSocialPost(data) {
        let promo = data.storePromotion;
        let storePath = /databases/$(database)/documents/stores/$(promo.storeId);
        let couponPath = /databases/$(database)/documents/stores/$(promo.storeId)/promotions/$(promo.promotionId);
        return promo is map
          && promo.keys().hasAll(['storeId', 'promotionId'])
          && promo.keys().hasOnly(['storeId', 'promotionId'])
          && promo.storeId is string
          && promo.promotionId is string
          && promo.storeId.size() > 0
          && promo.promotionId.size() > 0
          && exists(storePath)
          && get(storePath).data.ownerId == request.auth.uid
          && exists(couponPath)
          && get(couponPath).data.active == true
          && (get(couponPath).data.maxRedemptions == 0
            || get(couponPath).data.redemptionCount < get(couponPath).data.maxRedemptions)
          && data.authorName == get(storePath).data.name
          && data.visibility == 'public'
          && data.publicationType == 'feed';
      }

      function validStoreReviewSocialPost(data) {
        let link = data.storeReview;
        let reviewPath = /databases/$(database)/documents/store_reviews/$(link.storeId)/reviews/$(link.reviewId);
        return link is map
          && link.keys().hasAll(['storeId', 'reviewId', 'rating', 'storeName'])
          && link.keys().hasOnly(['storeId', 'reviewId', 'rating', 'storeName'])
          && isValidId(link.storeId)
          && isValidId(link.reviewId)
          && link.rating is int
          && link.rating >= 1
          && link.rating <= 5
          && link.storeName is string
          && data.postId == 'review_' + link.storeId + '_' + link.reviewId
          && data.sourcePostId == link.reviewId
          && data.publicationType == 'feed'
          && data.visibility == 'public'
          && data.audienceIds.size() == 0
          && existsAfter(reviewPath)
          && getAfter(reviewPath).data.status == 'published'
          && getAfter(reviewPath).data.publishedToFeed == true
          && getAfter(reviewPath).data.postId == data.postId
          && getAfter(reviewPath).data.storeId == link.storeId
          && getAfter(reviewPath).data.storeName == link.storeName
          && getAfter(reviewPath).data.rating == link.rating
          && getAfter(reviewPath).data.authorId == data.authorId
          && getAfter(reviewPath).data.authorName == data.authorName
          && getAfter(reviewPath).data.authorAvatar == data.authorAvatar
          && getAfter(reviewPath).data.content == data.content
          && getAfter(reviewPath).data.createdAtIso == data.createdAtIso
          && data.mediaUrls == (
            getAfter(reviewPath).data.mediaUrl == ''
              ? []
              : [getAfter(reviewPath).data.mediaUrl]
          );
      }

      function hasValidSocialPostShape(data) {
        return data.keys().hasAll([
          'postId',
          'sourcePostId',
          'authorId',
          'authorName',
          'authorAvatar',
          'content',
          'publicationType',
          'taggedUsers',
          'taggedUserIds',
          'mediaUrls',
          'visibility',
          'audienceIds',
          'createdAtIso',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'postId',
          'sourcePostId',
          'authorId',
          'authorName',
          'authorAvatar',
          'content',
          'publicationType',
          'taggedUsers',
          'taggedUserIds',
          'mediaUrls',
          'visibility',
          'audienceIds',
          'createdAtIso',
          'createdAt',
          'updatedAt',
          'storePromotion',
          'storeReview'
        ])
        && !(data.keys().hasAny(['storePromotion']) && data.keys().hasAny(['storeReview']))
        && (!data.keys().hasAny(['storePromotion']) || validStoreCouponSocialPost(data))
        && (!data.keys().hasAny(['storeReview']) || validStoreReviewSocialPost(data))
        && data.postId == postId
        && data.sourcePostId is string
        && data.sourcePostId.size() > 0
        && data.sourcePostId.size() <= 500
        && data.authorId is string
        && data.authorId.size() > 0
        && data.authorId.size() <= 128
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 160
        && data.authorAvatar is string
        && data.authorAvatar.size() <= 2048
        && data.content is string
        && data.content.size() <= 3000
        && data.publicationType in ['feed', 'status']
        && data.taggedUsers is list
        && data.taggedUsers.size() <= 30
        && data.taggedUserIds is list
        && data.taggedUserIds.size() <= 30
        && data.mediaUrls is list
        && data.mediaUrls.size() <= 9
        && data.visibility in ['public', 'private', 'connections']
        && data.audienceIds is list
        && data.audienceIds.size() <= 500
        && (
          (
            data.publicationType == 'feed'
            && (
              (
                data.visibility == 'public'
                && data.audienceIds.size() <= 30
              )
              || (
                data.visibility == 'private'
                && data.authorId in data.audienceIds
                && data.audienceIds.hasAll(data.taggedUserIds)
              )
            )
          )
          || (
            data.publicationType == 'status'
            && data.visibility in ['connections', 'public']
            && data.authorId in data.audienceIds
            && data.audienceIds.hasAll(data.taggedUserIds)
          )
        )
        && data.createdAtIso is string
        && data.createdAtIso.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
      }

      allow read: if isSignedIn()
        && existing().visibility == 'public';

      allow read: if isSignedIn()
        && existing().authorId == request.auth.uid;

      allow read: if isSignedIn()
        && request.auth.uid in existing().audienceIds;

      allow create: if isSignedIn()
        && !postId.matches('^reputation_.*')
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidSocialPostShape(incoming());

      allow update: if isSignedIn()
        && !postId.matches('^reputation_.*')
        && existing().authorId == request.auth.uid
        && incoming().authorId == existing().authorId
        && incoming().postId == existing().postId
        && incoming().sourcePostId == existing().sourcePostId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!existing().keys().hasAny(['storePromotion']) || (
          incoming().storePromotion == existing().storePromotion
          && validStoreCouponSocialPost(incoming())
        ))
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorName',
          'authorAvatar',
          'content',
          'publicationType',
          'taggedUsers',
          'taggedUserIds',
          'mediaUrls',
          'visibility',
          'audienceIds',
          'createdAtIso',
          'updatedAt'
        ])
        && hasValidSocialPostShape(incoming());

      allow delete: if isSignedIn()
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    // One review per authenticated user and published store. A Praça post, if selected,
    // is created in the same Firestore batch; it never mints Pitangas or XP.
    match /store_reviews/{storeId}/reviews/{reviewId} {
      function linkedListingPath() {
        return /databases/$(database)/documents/marketplace_listings/$('s_' + string(storeId.size()) + '_' + storeId);
      }

      function publishedReviewStore(data) {
        let listing = linkedListingPath();
        let tenant = /databases/$(database)/documents/tenants/$(storeId);
        return (
          exists(listing)
          && get(listing).data.listingType == 'store'
          && get(listing).data.publicationStatus == 'published'
          && get(listing).data.storeId == storeId
          && get(listing).data.ownerId != request.auth.uid
          && get(listing).data.name == data.storeName
        ) || (
          exists(tenant)
          && get(tenant).data.publicationStatus == 'published'
          && get(tenant).data.ownerId != request.auth.uid
          && get(tenant).data.name == data.storeName
        );
      }

      function validReview(data) {
        let post = /databases/$(database)/documents/social_posts/$(data.postId);
        return isValidId(storeId)
          && isValidId(reviewId)
          && reviewId == request.auth.uid
          && data.keys().hasAll([
            'reviewId', 'storeId', 'storeName', 'authorId', 'authorName',
            'authorAvatar', 'content', 'rating', 'mediaUrl',
            'publishedToFeed', 'postId', 'status', 'createdAtIso', 'createdAt'
          ])
          && data.keys().hasOnly([
            'reviewId', 'storeId', 'storeName', 'authorId', 'authorName',
            'authorAvatar', 'content', 'rating', 'mediaUrl',
            'publishedToFeed', 'postId', 'status', 'createdAtIso', 'createdAt'
          ])
          && data.reviewId == reviewId
          && data.storeId == storeId
          && data.authorId == request.auth.uid
          && data.authorName is string
          && data.authorName.size() > 0
          && data.authorName.size() <= 160
          && data.authorAvatar is string
          && data.authorAvatar.size() <= 2048
          && data.storeName is string
          && data.storeName.size() > 0
          && data.storeName.size() <= 160
          && data.content is string
          && data.content.size() >= 10
          && data.content.size() <= 2000
          && data.rating is int
          && data.rating >= 1
          && data.rating <= 5
          && data.mediaUrl is string
          && data.mediaUrl.size() <= 2048
          && data.publishedToFeed is bool
          && data.postId is string
          && data.postId.size() <= 500
          && data.status == 'published'
          && data.createdAtIso is string
          && data.createdAtIso.size() > 0
          && data.createdAtIso.size() <= 64
          && data.createdAt == request.time
          && publishedReviewStore(data)
          && (
            (!data.publishedToFeed && data.postId == '')
            || (
              data.publishedToFeed
              && data.postId == 'review_' + storeId + '_' + reviewId
              && existsAfter(post)
              && getAfter(post).data.postId == data.postId
              && getAfter(post).data.authorId == request.auth.uid
              && getAfter(post).data.storeReview.storeId == storeId
              && getAfter(post).data.storeReview.reviewId == reviewId
            )
          );
      }

      allow get: if isSignedIn()
        && (resource == null || existing().status == 'published');
      allow list: if isSignedIn()
        && existing().status == 'published';
      allow create: if isSignedIn() && validReview(incoming());
      allow update: if false;
      // No orphan posts: author may retract a review only after its Praça post
      // is removed, or when the review was never cross-posted.
      allow delete: if isSignedIn()
        && existing().authorId == request.auth.uid
        && (
          !existing().publishedToFeed
          || !existsAfter(/databases/$(database)/documents/social_posts/$(existing().postId))
        );
    }

    // Denúncia independente de compartilhamento na Praça.
    // Um documento imutável por (loja, avaliação, denunciante), sem punição automática.
    match /store_review_reports/{reportId} {
      function targetReview() {
        return /databases/$(database)/documents/store_reviews/$(incoming().storeId)/reviews/$(incoming().reviewId);
      }
      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'reportId', 'storeId', 'reviewId', 'authorId', 'reporterId',
          'reason', 'status', 'createdAt'
        ])
        && incoming().keys().hasOnly([
          'reportId', 'storeId', 'reviewId', 'authorId', 'reporterId',
          'reason', 'status', 'createdAt'
        ])
        && incoming().reportId == reportId
        && incoming().storeId is string
        && isValidId(incoming().storeId)
        && incoming().reviewId is string
        && isValidId(incoming().reviewId)
        && incoming().authorId is string
        && isValidId(incoming().authorId)
        && incoming().reporterId == request.auth.uid
        && incoming().authorId != request.auth.uid
        && incoming().reason in ['spam', 'abuse', 'fraud', 'unsafe', 'other']
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && reportId == incoming().storeId + '__' + incoming().reviewId + '__' + request.auth.uid
        && exists(targetReview())
        && get(targetReview()).data.status == 'published'
        && get(targetReview()).data.authorId == incoming().authorId
        && get(targetReview()).data.storeId == incoming().storeId;
      allow get: if isSignedIn()
        && (existing().reporterId == request.auth.uid || isAdmin());
      allow list, update, delete: if false;
    }

    match /social_post_likes/{likeId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && incoming().keys().hasAll(['postId', 'userId', 'createdAt'])
        && incoming().keys().hasOnly(['postId', 'userId', 'createdAt'])
        && incoming().postId is string
        && incoming().postId.size() > 0
        && incoming().postId.size() <= 500
        && incoming().userId == request.auth.uid
        && likeId == incoming().postId + '__' + request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/social_posts/$(incoming().postId));

      allow update: if false;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /social_post_comments/{commentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'postId',
          'authorId',
          'authorName',
          'authorAvatar',
          'text',
          'createdAtIso',
          'createdAt'
        ])
        && incoming().keys().hasOnly([
          'postId',
          'authorId',
          'authorName',
          'authorAvatar',
          'text',
          'createdAtIso',
          'createdAt',
          'parentCommentId'
        ])
        && incoming().postId is string
        && incoming().postId.size() > 0
        && incoming().postId.size() <= 500
        && incoming().authorId == request.auth.uid
        && incoming().authorName is string
        && incoming().authorName.size() > 0
        && incoming().authorName.size() <= 160
        && incoming().authorAvatar is string
        && incoming().authorAvatar.size() <= 2048
        && incoming().text is string
        && incoming().text.size() > 0
        && incoming().text.size() <= 1000
        && incoming().createdAtIso is string
        && incoming().createdAtIso.size() <= 64
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/social_posts/$(incoming().postId))
        && (!('parentCommentId' in incoming()) || (
          incoming().parentCommentId is string
          && incoming().parentCommentId.size() > 0
          && incoming().parentCommentId.size() <= 160
          && incoming().parentCommentId != commentId
          && exists(/databases/$(database)/documents/social_post_comments/$(incoming().parentCommentId))
          && get(/databases/$(database)/documents/social_post_comments/$(incoming().parentCommentId)).data.postId == incoming().postId
        ));

      allow update: if false;
      allow delete: if isSignedIn()
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /social_post_reports/{reportId} {
      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'reportId',
          'postId',
          'reporterId',
          'authorId',
          'reason',
          'status',
          'createdAt'
        ])
        && incoming().keys().hasOnly([
          'reportId',
          'postId',
          'reporterId',
          'authorId',
          'reason',
          'status',
          'createdAt'
        ])
        && incoming().reportId == reportId
        && incoming().postId is string
        && incoming().postId.size() > 0
        && incoming().postId.size() <= 500
        && incoming().reporterId == request.auth.uid
        && incoming().authorId is string
        && incoming().authorId.size() <= 128
        && incoming().reason is string
        && incoming().reason.size() > 0
        && incoming().reason.size() <= 500
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && reportId == incoming().postId + '__' + request.auth.uid
        && exists(/databases/$(database)/documents/social_posts/$(incoming().postId))
        && get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.authorId == incoming().authorId
        && incoming().authorId != request.auth.uid
        && (
          get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.visibility == 'public'
          || request.auth.uid in get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.audienceIds
        );

      allow read: if isSignedIn()
        && (existing().reporterId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // A user can report another existing user once. The report is immutable to clients.
    match /social_user_reports/{reportId} {
      allow create: if isSignedIn()
        && incoming().keys().hasAll(['reportId', 'targetUserId', 'reporterId', 'reason', 'status', 'createdAt'])
        && incoming().keys().hasOnly(['reportId', 'targetUserId', 'reporterId', 'reason', 'status', 'createdAt'])
        && incoming().reportId == reportId
        && incoming().reporterId == request.auth.uid
        && incoming().targetUserId is string
        && incoming().targetUserId.size() > 0
        && incoming().targetUserId.size() <= 128
        && incoming().targetUserId != request.auth.uid
        && incoming().reason is string
        && incoming().reason.size() >= 3
        && incoming().reason.size() <= 500
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && reportId == incoming().targetUserId + '__' + request.auth.uid
        && exists(/databases/$(database)/documents/users/$(incoming().targetUserId));
      allow read: if isSignedIn()
        && (existing().reporterId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /social_post_engagements/{engagementId} {
      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'engagementId',
          'postId',
          'postAuthorId',
          'actorId',
          'type',
          'createdAt'
        ])
        && incoming().keys().hasOnly([
          'engagementId',
          'postId',
          'postAuthorId',
          'actorId',
          'type',
          'createdAt'
        ])
        && incoming().engagementId == engagementId
        && incoming().postId is string
        && incoming().postId.size() > 0
        && incoming().postId.size() <= 500
        && incoming().postAuthorId is string
        && incoming().postAuthorId.size() > 0
        && incoming().postAuthorId.size() <= 128
        && incoming().actorId == request.auth.uid
        && incoming().type in ['view', 'save', 'share']
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/social_posts/$(incoming().postId))
        && get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.authorId
          == incoming().postAuthorId
        && (
          get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.visibility
            == 'public'
          || get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.authorId
            == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.audienceIds
        )
        && (
          incoming().type == 'share'
          || engagementId
            == incoming().postId + '__' + incoming().type + '__' + request.auth.uid
        );

      allow read: if isSignedIn()
        && (
          existing().actorId == request.auth.uid
          || existing().postAuthorId == request.auth.uid
          || isAdmin()
        );

      allow update: if false;

      allow delete: if isSignedIn()
        && existing().type == 'save'
        && (existing().actorId == request.auth.uid || isAdmin());
    }
match /social_post_campaigns/{campaignId} {
      function hasValidSocialCampaignShape(data) {
        return data.keys().hasAll([
          'campaignId',
          'ownerId',
          'postId',
          'objective',
          'dailyBudgetCents',
          'startDate',
          'endDate',
          'audienceLocation',
          'status',
          'deliveryMode',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'campaignId',
          'ownerId',
          'postId',
          'objective',
          'dailyBudgetCents',
          'startDate',
          'endDate',
          'audienceLocation',
          'status',
          'deliveryMode',
          'createdAt',
          'updatedAt'
        ])
        && data.campaignId == campaignId
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128
        && data.postId is string
        && data.postId.size() > 0
        && data.postId.size() <= 500
        && data.objective in [
          'reach',
          'engagement',
          'messages'
        ]
        && data.dailyBudgetCents is int
        && data.dailyBudgetCents >= 500
        && data.dailyBudgetCents <= 100000000
        && data.startDate is string
        && data.startDate.size() == 10
        && data.endDate is string
        && data.endDate.size() == 10
        && data.audienceLocation is string
        && data.audienceLocation.size() > 0
        && data.audienceLocation.size() <= 160
        && data.status in [
          'active',
          'paused',
          'ended'
        ]
        && data.deliveryMode == 'configuration_only'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
      }

      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidSocialCampaignShape(incoming())
        && exists(
          /databases/$(database)/documents/social_posts/$(incoming().postId)
        )
        && get(
          /databases/$(database)/documents/social_posts/$(incoming().postId)
        ).data.authorId == request.auth.uid
        && get(
          /databases/$(database)/documents/social_posts/$(incoming().postId)
        ).data.publicationType == 'feed';

      allow read: if isSignedIn()
        && (
          existing().ownerId == request.auth.uid
          || isAdmin()
        );

      allow update: if isSignedIn()
        && existing().ownerId == request.auth.uid
        && existing().status != 'ended'
        && incoming().campaignId == existing().campaignId
        && incoming().ownerId == existing().ownerId
        && incoming().postId == existing().postId
        && incoming().objective == existing().objective
        && incoming().dailyBudgetCents == existing().dailyBudgetCents
        && incoming().startDate == existing().startDate
        && incoming().endDate == existing().endDate
        && incoming().audienceLocation == existing().audienceLocation
        && incoming().deliveryMode == existing().deliveryMode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ])
        && hasValidSocialCampaignShape(incoming());

      allow delete: if false;
    }
