    // --- Public Social Feed, Connection Status, Likes, Comments and Reports ---
    match /social_posts/{postId} {
      function hasValidSocialPostShape(data) {
        return data.keys().hasAll([
          'postId',
          'sourcePostId',
          'authorId',
          'authorName',
          'authorAvatar',
          'content',
          'publicationType',
          'taggedUsers',
          'taggedUserIds',
          'mediaUrls',
          'visibility',
          'audienceIds',
          'createdAtIso',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'postId',
          'sourcePostId',
          'authorId',
          'authorName',
          'authorAvatar',
          'content',
          'publicationType',
          'taggedUsers',
          'taggedUserIds',
          'mediaUrls',
          'visibility',
          'audienceIds',
          'createdAtIso',
          'createdAt',
          'updatedAt'
        ])
        && data.postId == postId
        && data.sourcePostId is string
        && data.sourcePostId.size() > 0
        && data.sourcePostId.size() <= 500
        && data.authorId is string
        && data.authorId.size() > 0
        && data.authorId.size() <= 128
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 160
        && data.authorAvatar is string
        && data.authorAvatar.size() <= 2048
        && data.content is string
        && data.content.size() <= 3000
        && data.publicationType in ['feed', 'status']
        && data.taggedUsers is list
        && data.taggedUsers.size() <= 30
        && data.taggedUserIds is list
        && data.taggedUserIds.size() <= 30
        && data.mediaUrls is list
        && data.mediaUrls.size() <= 9
        && data.visibility in ['public', 'private', 'connections']
        && data.audienceIds is list
        && data.audienceIds.size() <= 500
        && (
          (
            data.publicationType == 'feed'
            && (
              (
                data.visibility == 'public'
                && data.audienceIds.size() <= 30
              )
              || (
                data.visibility == 'private'
                && data.authorId in data.audienceIds
                && data.audienceIds.hasAll(data.taggedUserIds)
              )
            )
          )
          || (
            data.publicationType == 'status'
            && data.visibility in ['connections', 'public']
            && data.authorId in data.audienceIds
            && data.audienceIds.hasAll(data.taggedUserIds)
          )
        )
        && data.createdAtIso is string
        && data.createdAtIso.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
      }

      allow read: if isSignedIn()
        && existing().visibility == 'public';

      allow read: if isSignedIn()
        && existing().authorId == request.auth.uid;

      allow read: if isSignedIn()
        && request.auth.uid in existing().audienceIds;

      allow create: if isSignedIn()
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidSocialPostShape(incoming());

      allow update: if isSignedIn()
        && existing().authorId == request.auth.uid
        && incoming().authorId == existing().authorId
        && incoming().postId == existing().postId
        && incoming().sourcePostId == existing().sourcePostId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorName',
          'authorAvatar',
          'content',
          'publicationType',
          'taggedUsers',
          'taggedUserIds',
          'mediaUrls',
          'visibility',
          'audienceIds',
          'createdAtIso',
          'updatedAt'
        ])
        && hasValidSocialPostShape(incoming());

      allow delete: if isSignedIn()
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /social_post_likes/{likeId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && incoming().keys().hasAll(['postId', 'userId', 'createdAt'])
        && incoming().keys().hasOnly(['postId', 'userId', 'createdAt'])
        && incoming().postId is string
        && incoming().postId.size() > 0
        && incoming().postId.size() <= 500
        && incoming().userId == request.auth.uid
        && likeId == incoming().postId + '__' + request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/social_posts/$(incoming().postId));

      allow update: if false;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /social_post_comments/{commentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'postId',
          'authorId',
          'authorName',
          'authorAvatar',
          'text',
          'createdAtIso',
          'createdAt'
        ])
        && incoming().keys().hasOnly([
          'postId',
          'authorId',
          'authorName',
          'authorAvatar',
          'text',
          'createdAtIso',
          'createdAt'
        ])
        && incoming().postId is string
        && incoming().postId.size() > 0
        && incoming().postId.size() <= 500
        && incoming().authorId == request.auth.uid
        && incoming().authorName is string
        && incoming().authorName.size() > 0
        && incoming().authorName.size() <= 160
        && incoming().authorAvatar is string
        && incoming().authorAvatar.size() <= 2048
        && incoming().text is string
        && incoming().text.size() > 0
        && incoming().text.size() <= 1000
        && incoming().createdAtIso is string
        && incoming().createdAtIso.size() <= 64
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/social_posts/$(incoming().postId));

      allow update: if false;
      allow delete: if isSignedIn()
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /social_post_reports/{reportId} {
      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'reportId',
          'postId',
          'reporterId',
          'authorId',
          'reason',
          'status',
          'createdAt'
        ])
        && incoming().keys().hasOnly([
          'reportId',
          'postId',
          'reporterId',
          'authorId',
          'reason',
          'status',
          'createdAt'
        ])
        && incoming().reportId == reportId
        && incoming().postId is string
        && incoming().postId.size() > 0
        && incoming().postId.size() <= 500
        && incoming().reporterId == request.auth.uid
        && incoming().authorId is string
        && incoming().authorId.size() <= 128
        && incoming().reason is string
        && incoming().reason.size() > 0
        && incoming().reason.size() <= 500
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && reportId == incoming().postId + '__' + request.auth.uid
        && exists(/databases/$(database)/documents/social_posts/$(incoming().postId));

      allow read: if isSignedIn()
        && (existing().reporterId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /social_post_engagements/{engagementId} {
      allow create: if isSignedIn()
        && incoming().keys().hasAll([
          'engagementId',
          'postId',
          'postAuthorId',
          'actorId',
          'type',
          'createdAt'
        ])
        && incoming().keys().hasOnly([
          'engagementId',
          'postId',
          'postAuthorId',
          'actorId',
          'type',
          'createdAt'
        ])
        && incoming().engagementId == engagementId
        && incoming().postId is string
        && incoming().postId.size() > 0
        && incoming().postId.size() <= 500
        && incoming().postAuthorId is string
        && incoming().postAuthorId.size() > 0
        && incoming().postAuthorId.size() <= 128
        && incoming().actorId == request.auth.uid
        && incoming().type in ['view', 'save', 'share']
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/social_posts/$(incoming().postId))
        && get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.authorId
          == incoming().postAuthorId
        && (
          get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.visibility
            == 'public'
          || get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.authorId
            == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/social_posts/$(incoming().postId)).data.audienceIds
        )
        && (
          incoming().type == 'share'
          || engagementId
            == incoming().postId + '__' + incoming().type + '__' + request.auth.uid
        );

      allow read: if isSignedIn()
        && (
          existing().actorId == request.auth.uid
          || existing().postAuthorId == request.auth.uid
          || isAdmin()
        );

      allow update: if false;

      allow delete: if isSignedIn()
        && existing().type == 'save'
        && (existing().actorId == request.auth.uid || isAdmin());
    }
