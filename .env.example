# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: Hosting URL supplied by AI Studio/Cloud Run when available.
APP_URL=

# Public HTTPS origin used by webhooks and operational schedulers.
PUBLIC_APP_URL=https://app.kyrub.com

# Firebase Admin configuration. Prefer Application Default Credentials in
# managed Google environments. Never commit a real service account JSON.
FIREBASE_PROJECT_ID=kyrub-b8d0e
FIREBASE_SERVICE_ACCOUNT_JSON=

# Integration secret vault and protected worker authentication.
# Generate the master key with: openssl rand -base64 32
# Use a different, long random value for the cron secret.
INTEGRATION_MASTER_KEY=
INTEGRATION_CRON_SECRET=

# Cloud Scheduler defaults. The polling schedule must be confirmed with 99Food.
SCHEDULER_LOCATION=southamerica-east1
SCHEDULER_TIME_ZONE=America/Sao_Paulo
NINETY_NINE_FOOD_POLL_SCHEDULE=*/5 * * * *

# Google Drive and Google Photos media pickers.
# The Kyrub Firebase API key and project number are used as defaults, so these
# overrides are optional. Enable Google Drive API, Google Picker API and Google
# Photos Picker API in Google Cloud project 636039448089. Add both drive.file
# and photospicker.mediaitems.readonly to the OAuth consent screen.
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=636039448089
