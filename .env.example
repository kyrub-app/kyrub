# Core runtime
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
KYRUB_RELEASE=development

# Legacy hosting URL retained for compatibility where still referenced.
APP_URL=

# Kyrubia / Gemini
# Never prefix server secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Firebase Admin configuration. Prefer Application Default Credentials in
# managed Google environments. Never commit a real service account JSON.
FIREBASE_PROJECT_ID=kyrub-b8d0e
GCLOUD_PROJECT=kyrub-b8d0e
FIREBASE_SERVICE_ACCOUNT_JSON=

# Identity verification and transaction security.
# Keep the UI disabled until Firestore/Storage rules and the PIN pepper have
# been deployed. Development mode enables the workspace automatically.
VITE_IDENTITY_VERIFICATION_ENABLED=false
# Long server-only pepper used with scrypt for four-digit transactional PINs.
# Generate with: openssl rand -base64 48
SECURITY_PIN_PEPPER=

# Integration secret vault and protected worker authentication.
# Generate the master key with: openssl rand -base64 32
# Use a different, long random value for the cron secret.
INTEGRATION_MASTER_KEY=
INTEGRATION_CRON_SECRET=

# Cloud Scheduler defaults. The polling schedule must be confirmed with 99Food.
SCHEDULER_LOCATION=southamerica-east1
SCHEDULER_TIME_ZONE=America/Sao_Paulo
NINETY_NINE_FOOD_POLL_SCHEDULE="*/5 * * * *"

# Google Drive and Google Photos media pickers.
# These values are intentionally public browser configuration, not secrets.
# Enable Google Drive API, Google Picker API and Google Photos Picker API in
# the configured Google Cloud project and review the OAuth consent screen.
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=636039448089

# Vercel injects VERCEL_ENV and VERCEL_GIT_COMMIT_SHA automatically.
