    // --- Identity verification, KYC and work eligibility ---
    match /identity_verifications/{userId} {
      function isVerificationOwner() {
        return isSignedIn() && request.auth.uid == userId;
      }

      function validVerificationProfiles(profiles) {
        return profiles is list
          && profiles.size() <= 4
          && profiles.hasOnly([
            'requester',
            'freelancer',
            'bicycle_courier',
            'motorized_courier'
          ]);
      }

      // Optional, private request for a second courier qualification.
      function validProfileExpansion(expansion) {
        return expansion is map
          && expansion.keys().hasAll([
            'profile', 'status', 'cnhCategory', 'cnhHasEar',
            'documentPaths', 'submittedAt', 'reviewedAt', 'reviewedBy', 'reviewReason'
          ])
          && expansion.keys().hasOnly([
            'profile', 'status', 'cnhCategory', 'cnhHasEar',
            'documentPaths', 'submittedAt', 'reviewedAt', 'reviewedBy', 'reviewReason'
          ])
          && expansion.profile in ['bicycle_courier', 'motorized_courier']
          && expansion.status in ['submitted', 'approved', 'rejected']
          && expansion.cnhCategory is string && expansion.cnhCategory.size() <= 8
          && expansion.cnhHasEar is bool
          && expansion.documentPaths is list && expansion.documentPaths.size() <= 2
          && (expansion.documentPaths.size() == 0
            || (expansion.documentPaths[0] is string
              && expansion.documentPaths[0].matches('^identity-verification/' + userId + '/document/[^/]+$')))
          && (expansion.documentPaths.size() < 2
            || (expansion.documentPaths[1] is string
              && expansion.documentPaths[1].matches('^identity-verification/' + userId + '/document/[^/]+$')))
          && expansion.submittedAt is timestamp
          && (expansion.reviewedAt == null || expansion.reviewedAt is timestamp)
          && expansion.reviewedBy is string && expansion.reviewedBy.size() <= 128
          && expansion.reviewReason is string && expansion.reviewReason.size() <= 500;
      }

      function validMotofreteDocument(path, optional) {
        return path is string && (
          (optional && path == '')
          || (path.size() <= 500
            && path.matches('^identity-verification/' + userId + '/document/[^/]+$'))
        );
      }

      function validMotofreteQualification(qualification) {
        return qualification is map
          && qualification.keys().hasAll([
            'status', 'documents', 'submittedAt', 'reviewedAt', 'reviewedBy', 'reviewReason',
            'courseVerified', 'minimumAgeAndLicenseTenureVerified',
            'vehicleRegistrationAndAuthorizationVerified', 'safetyEquipmentVerified',
            'semiannualInspectionVerified', 'localRequirementsVerified', 'validUntil'
          ])
          && qualification.keys().hasOnly([
            'status', 'documents', 'submittedAt', 'reviewedAt', 'reviewedBy', 'reviewReason',
            'courseVerified', 'minimumAgeAndLicenseTenureVerified',
            'vehicleRegistrationAndAuthorizationVerified', 'safetyEquipmentVerified',
            'semiannualInspectionVerified', 'localRequirementsVerified', 'validUntil'
          ])
          && qualification.status in ['submitted', 'approved', 'rejected', 'revoked']
          && qualification.documents is map
          && qualification.documents.keys().hasAll([
            'course', 'vehicle', 'inspection', 'equipment', 'local'
          ])
          && qualification.documents.keys().hasOnly([
            'course', 'vehicle', 'inspection', 'equipment', 'local'
          ])
          && validMotofreteDocument(qualification.documents.course, false)
          && validMotofreteDocument(qualification.documents.vehicle, false)
          && validMotofreteDocument(qualification.documents.inspection, false)
          && validMotofreteDocument(qualification.documents.equipment, false)
          && validMotofreteDocument(qualification.documents.local, true)
          && qualification.submittedAt is timestamp
          && (qualification.reviewedAt == null || qualification.reviewedAt is timestamp)
          && qualification.reviewedBy is string && qualification.reviewedBy.size() <= 128
          && qualification.reviewReason is string && qualification.reviewReason.size() <= 500
          && qualification.courseVerified is bool
          && qualification.minimumAgeAndLicenseTenureVerified is bool
          && qualification.vehicleRegistrationAndAuthorizationVerified is bool
          && qualification.safetyEquipmentVerified is bool
          && qualification.semiannualInspectionVerified is bool
          && qualification.localRequirementsVerified is bool
          && (qualification.validUntil == null || qualification.validUntil is timestamp);
      }

      function motofreteChecklistApproved(qualification) {
        return qualification.courseVerified == true
          && qualification.minimumAgeAndLicenseTenureVerified == true
          && qualification.vehicleRegistrationAndAuthorizationVerified == true
          && qualification.safetyEquipmentVerified == true
          && qualification.semiannualInspectionVerified == true
          && qualification.localRequirementsVerified == true;
      }

      function motofreteChecklistNotVerified(qualification) {
        return qualification.courseVerified == false
          && qualification.minimumAgeAndLicenseTenureVerified == false
          && qualification.vehicleRegistrationAndAuthorizationVerified == false
          && qualification.safetyEquipmentVerified == false
          && qualification.semiannualInspectionVerified == false
          && qualification.localRequirementsVerified == false;
      }

      function validIdentityVerification(data) {
        return data.keys().hasAll([
          'uid',
          'status',
          'requestedProfiles',
          'approvedProfiles',
          'fullName',
          'cpf',
          'address',
          'whatsapp',
          'documentType',
          'documentPaths',
          'selfiePath',
          'cnhCategory',
          'cnhHasEar',
          'consentVersion',
          'reviewReason',
          'reviewedBy',
          'reviewedAt',
          'submittedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'status',
          'requestedProfiles',
          'approvedProfiles',
          'fullName',
          'cpf',
          'address',
          'whatsapp',
          'documentType',
          'documentPaths',
          'selfiePath',
          'cnhCategory',
          'cnhHasEar',
          'consentVersion',
          'reviewReason',
          'reviewedBy',
          'reviewedAt',
          'submittedAt',
          'createdAt',
          'updatedAt',
          'profileExpansion',
          'motofreteQualification'
        ])
        && data.uid == userId
        && data.status in ['draft', 'submitted', 'under_review', 'approved', 'rejected']
        && validVerificationProfiles(data.requestedProfiles)
        && validVerificationProfiles(data.approvedProfiles)
        && data.fullName is string
        && data.fullName.size() <= 160
        && data.cpf is string
        && data.cpf.matches('^[0-9]{11}$')
        && data.address is string
        && data.address.size() <= 300
        && data.whatsapp is string
        && data.whatsapp.size() <= 40
        && data.documentType in ['cin', 'rg', 'cnh']
        && data.documentPaths is list
        && data.documentPaths.size() <= 4
        && data.selfiePath is string
        && data.selfiePath.size() <= 500
        && data.cnhCategory is string
        && data.cnhCategory.size() <= 8
        && data.cnhHasEar is bool
        && data.consentVersion is string
        && data.consentVersion.size() <= 32
        && data.reviewReason is string
        && data.reviewReason.size() <= 500
        && data.reviewedBy is string
        && data.reviewedBy.size() <= 128
        && (!('profileExpansion' in data) || validProfileExpansion(data.profileExpansion))
        && (!('motofreteQualification' in data)
          || validMotofreteQualification(data.motofreteQualification));
      }

      allow get: if isVerificationOwner() || isActiveControlPlaneAdmin();
      allow list: if hasControlPlaneRole([
        'super_admin',
        'support',
        'operations',
        'compliance'
      ]) && request.query.limit != null && request.query.limit <= 100;

      allow create: if isVerificationOwner()
        && validIdentityVerification(incoming())
        && incoming().status in ['draft', 'submitted']
        && !('profileExpansion' in incoming())
        && !('motofreteQualification' in incoming())
        && incoming().approvedProfiles.size() == 0
        && incoming().reviewReason == ''
        && incoming().reviewedBy == ''
        && incoming().reviewedAt == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().status == 'draft'
            ? incoming().submittedAt == null
            : incoming().submittedAt == request.time
        );

      // Route exactly one transition by authenticated actor, current status
      // and affected field before validating the common schema. This avoids
      // Firestore's 1000-expression cap on unrelated owner/reviewer clauses.
      // A reviewer cannot approve their own identity in this direct path.
      allow update: if (
        isVerificationOwner()
          ? (
              existing().status == 'approved'
                ? (
                    incoming().diff(existing()).affectedKeys().hasAny(['motofreteQualification'])
                      ? (isVerificationOwner()
        && existing().status == 'approved'
        && existing().approvedProfiles.hasAny(['motorized_courier'])
        && incoming().diff(existing()).affectedKeys().hasOnly(['motofreteQualification', 'updatedAt'])
        && incoming().updatedAt == request.time
        && (!('motofreteQualification' in existing())
          || existing().motofreteQualification.status in ['rejected', 'revoked', 'approved'])
        && incoming().motofreteQualification.status == 'submitted'
        && incoming().motofreteQualification.submittedAt == request.time
        && incoming().motofreteQualification.reviewedAt == null
        && incoming().motofreteQualification.reviewedBy == ''
        && incoming().motofreteQualification.reviewReason == ''
        && incoming().motofreteQualification.validUntil == null
        && motofreteChecklistNotVerified(incoming().motofreteQualification))
                      : (isVerificationOwner()
        && existing().status == 'approved'
        && incoming().diff(existing()).affectedKeys().hasOnly(['profileExpansion', 'updatedAt'])
        && incoming().updatedAt == request.time
        && (!('profileExpansion' in existing()) || existing().profileExpansion.status in ['rejected', 'approved'])
        && incoming().profileExpansion.status == 'submitted'
        && incoming().profileExpansion.submittedAt == request.time
        && incoming().profileExpansion.reviewedBy == ''
        && incoming().profileExpansion.reviewedAt == null
        && incoming().profileExpansion.reviewReason == ''
        && !existing().approvedProfiles.hasAny([incoming().profileExpansion.profile])
        && (
          incoming().profileExpansion.profile == 'bicycle_courier'
          || (
            incoming().profileExpansion.profile == 'motorized_courier'
            && incoming().profileExpansion.cnhCategory.size() > 0
            && incoming().profileExpansion.cnhHasEar == true
            && (
              incoming().profileExpansion.documentPaths.size() > 0
              || (
                existing().documentType == 'cnh'
                && existing().documentPaths.size() > 0
                && existing().cnhCategory.size() > 0
                && existing().cnhHasEar == true
              )
            )
          )
        ))
                  )
                : (isVerificationOwner()
        && existing().uid == userId
        && existing().status != 'approved'
        && !('profileExpansion' in incoming())
        && !('motofreteQualification' in incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().approvedProfiles == existing().approvedProfiles
        && incoming().reviewReason == existing().reviewReason
        && incoming().reviewedBy == existing().reviewedBy
        && incoming().reviewedAt == existing().reviewedAt
        && incoming().status in ['draft', 'submitted']
        && incoming().updatedAt == request.time
        && (
          incoming().status == 'draft'
            ? incoming().submittedAt == null
            : incoming().submittedAt == request.time
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'requestedProfiles',
          'fullName',
          'cpf',
          'address',
          'whatsapp',
          'documentType',
          'documentPaths',
          'selfiePath',
          'cnhCategory',
          'cnhHasEar',
          'consentVersion',
          'submittedAt',
          'updatedAt'
        ]))
            )
          : (
              hasControlPlaneRole(['super_admin','operations','compliance'])
              && (
                existing().status == 'approved'
                  ? (
                      incoming().diff(existing()).affectedKeys().hasAny(['motofreteQualification'])
                        ? false // Motofrete decisions are server-only and atomically audited.
                        : (hasControlPlaneRole(['super_admin', 'operations', 'compliance'])
        && existing().status == 'approved'
        && 'profileExpansion' in existing()
        && existing().profileExpansion.status == 'submitted'
        && incoming().status == 'approved'
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'profileExpansion', 'approvedProfiles', 'requestedProfiles', 'updatedAt'
        ])
        && incoming().profileExpansion.profile == existing().profileExpansion.profile
        && incoming().profileExpansion.submittedAt == existing().profileExpansion.submittedAt
        && incoming().profileExpansion.documentPaths == existing().profileExpansion.documentPaths
        && incoming().profileExpansion.cnhCategory == existing().profileExpansion.cnhCategory
        && incoming().profileExpansion.cnhHasEar == existing().profileExpansion.cnhHasEar
        && incoming().profileExpansion.reviewedBy == request.auth.uid
        && incoming().profileExpansion.reviewedAt == request.time
        && (
          (
            incoming().profileExpansion.status == 'approved'
            && incoming().profileExpansion.reviewReason == ''
            && incoming().approvedProfiles.hasAll(existing().approvedProfiles)
            && incoming().approvedProfiles.hasAny([existing().profileExpansion.profile])
            && incoming().approvedProfiles.size() == existing().approvedProfiles.size() + 1
            && incoming().requestedProfiles.hasAll(existing().requestedProfiles)
            && incoming().requestedProfiles.hasAny([existing().profileExpansion.profile])
            && incoming().requestedProfiles.size() <= existing().requestedProfiles.size() + 1
          )
          || (
            incoming().profileExpansion.status == 'rejected'
            && incoming().profileExpansion.reviewReason.size() > 0
            && incoming().approvedProfiles == existing().approvedProfiles
            && incoming().requestedProfiles == existing().requestedProfiles
          )
        ))
                    )
                  : (hasControlPlaneRole([
        'super_admin',
        'operations',
        'compliance'
      ])
        && existing().status != 'approved'
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().requestedProfiles == existing().requestedProfiles
        && incoming().fullName == existing().fullName
        && incoming().cpf == existing().cpf
        && incoming().address == existing().address
        && incoming().whatsapp == existing().whatsapp
        && incoming().documentType == existing().documentType
        && incoming().documentPaths == existing().documentPaths
        && incoming().selfiePath == existing().selfiePath
        && incoming().cnhCategory == existing().cnhCategory
        && incoming().cnhHasEar == existing().cnhHasEar
        && incoming().consentVersion == existing().consentVersion
        && incoming().submittedAt == existing().submittedAt
        && incoming().status in ['under_review', 'approved', 'rejected']
        && validVerificationProfiles(incoming().approvedProfiles)
        && incoming().reviewedBy == request.auth.uid
        && incoming().reviewedAt == request.time
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'approvedProfiles',
          'reviewReason',
          'reviewedBy',
          'reviewedAt',
          'updatedAt'
        ]))
              )
            )
      ) && (
        // The preceding motofrete transition limits the parent update to
        // ['motofreteQualification','updatedAt']; all identity data is unchanged.
        // Revalidating the entire identity AND the motofrete fields on the same
        // operation breaches Firestore's 1000-expression evaluation budget.
        incoming().diff(existing()).affectedKeys().hasAny(['motofreteQualification'])
          ? validMotofreteQualification(incoming().motofreteQualification)
          : validIdentityVerification(incoming())
      );

      allow delete: if false;
    }

    // Immutable server-owned audit history. No client (including administrators)
    // can create, edit or delete a review event.
    match /motofreteReviewEvents/{eventId} {
      allow get: if isSignedIn() &&
        (resource.data.userId == request.auth.uid
          || hasControlPlaneRole(['super_admin','compliance']));
      allow list: if isSignedIn()
        && request.query.limit != null && request.query.limit <= 50
        && (resource.data.userId == request.auth.uid
          || hasControlPlaneRole(['super_admin','compliance']));
      allow create, update, delete: if false;
    }

    // A hold is operational, not a second identity record. The owner may
    // inspect it; only the server can publish or clear it.
    match /courierComplianceHolds/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId
        || hasControlPlaneRole(['super_admin','operations','compliance']));
      allow list: if hasControlPlaneRole(['super_admin','operations','compliance'])
        && request.query.limit != null && request.query.limit <= 100;
      allow create, update, delete: if false;
    }

    // A logistics incident has no public order data or personal documents.
    match /deliveryComplianceIncidents/{deliveryId} {
      allow get: if hasControlPlaneRole(['super_admin','operations','compliance']);
      allow list: if hasControlPlaneRole(['super_admin','operations','compliance'])
        && request.query.limit != null && request.query.limit <= 100;
      allow create, update, delete: if false;
    }

    // An immutable, server-produced logistics disposition audit. Even an
    // administrator cannot forge a handoff or reopen a claim from the client.
    match /deliveryComplianceIncidentEvents/{eventId} {
      allow get: if hasControlPlaneRole(['super_admin','operations','compliance']);
      allow list: if hasControlPlaneRole(['super_admin','operations','compliance'])
        && request.query.limit != null && request.query.limit <= 50;
      allow create, update, delete: if false;
    }

    // Logistics nominates a replacement; only original/recipient couriers may
    // inspect their own assignment invitation. All mutations are server-only.
    match /deliveryCustodyTransfers/{deliveryId} {
      allow get: if isSignedIn()
        && (resource.data.fromCourierId == request.auth.uid
          || resource.data.toCourierId == request.auth.uid
          || hasControlPlaneRole(['super_admin','operations','compliance']));
      allow list: if isSignedIn()
        && request.query.limit != null && request.query.limit <= 100
        && (resource.data.fromCourierId == request.auth.uid
          || resource.data.toCourierId == request.auth.uid
          || hasControlPlaneRole(['super_admin','operations','compliance']));
      allow create, update, delete: if false;
    }

    // Server-owned, append-only declarations. This is a protected audit log,
    // not publicly verifiable proof of physical presence or custody by itself.
    match /deliveryCustodyTransferEvents/{eventId} {
      allow get: if hasControlPlaneRole(['super_admin','operations','compliance']);
      allow list: if hasControlPlaneRole(['super_admin','operations','compliance'])
        && request.query.limit != null && request.query.limit <= 50;
      allow create, update, delete: if false;
    }

    // A reviewed split is not an economic obligation. A courier can read
    // and accept only their own terms via the authenticated server route.
    // No client may alter either participant's consent or the amount.
    match /deliveryFinancialReconciliations/{deliveryId} {
      allow get: if isSignedIn()
        && (resource.data.fromCourierId == request.auth.uid
          || resource.data.toCourierId == request.auth.uid
          || hasControlPlaneRole(['super_admin','operations','compliance']));
      allow list: if isSignedIn()
        && request.query.limit != null && request.query.limit <= 100
        && (resource.data.fromCourierId == request.auth.uid
          || resource.data.toCourierId == request.auth.uid
          || hasControlPlaneRole(['super_admin','operations','compliance']));
      allow create, update, delete: if false;
    }

    // Append-only review and consent evidence; even administrative browsers
    // cannot manufacture ledger authority, approval or disbursement.
    match /deliveryFinancialReconciliationEvents/{eventId} {
      allow get: if hasControlPlaneRole(['super_admin','operations','compliance']);
      allow list: if hasControlPlaneRole(['super_admin','operations','compliance'])
        && request.query.limit != null && request.query.limit <= 50;
      allow create, update, delete: if false;
    }

    // Courier support is private to the assigned reporter and authorized
    // Control Plane staff. Neither can forge a cancellation or a ticket reply
    // through the browser; only authenticated server transactions may write.
    match /deliverySupportTickets/{ticketId} {
      allow get: if isSignedIn()
        && (resource.data.courierId == request.auth.uid
          || hasControlPlaneRole(['super_admin','operations','compliance']));
      allow list: if isSignedIn()
        && request.query.limit != null && request.query.limit <= 100
        && (resource.data.courierId == request.auth.uid
          || hasControlPlaneRole(['super_admin','operations','compliance']));
      allow create, update, delete: if false;
    }

    // Server-only audit trails must not be forged or erased by clients.
    match /deliverySupportTicketEvents/{eventId} {
      allow get: if hasControlPlaneRole(['super_admin','operations','compliance']);
      allow list: if hasControlPlaneRole(['super_admin','operations','compliance'])
        && request.query.limit != null && request.query.limit <= 50;
      allow create, update, delete: if false;
    }

    // Rate limits never need browser reads and contain no precise coordinates.
    match /deliverySupportRateLimits/{courierId} {
      allow read, write: if false;
    }

    // PIN hashes are server-only. Client and Control Plane screens use the
    // authenticated API and never read or write these documents directly.
    match /user_security/{userId} {
      allow read, write: if false;
    }
