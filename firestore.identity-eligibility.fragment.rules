    // --- Verified work eligibility helpers ---
    function identityVerificationDocument(userId) {
      return /databases/$(database)/documents/identity_verifications/$(userId);
    }

    function hasApprovedIdentityProfile(profile) {
      return isSignedIn()
        && exists(identityVerificationDocument(request.auth.uid))
        && get(identityVerificationDocument(request.auth.uid)).data.status == 'approved'
        && profile in get(identityVerificationDocument(request.auth.uid)).data.approvedProfiles;
    }

    function hasApprovedCourierProfile() {
      return hasApprovedIdentityProfile('bicycle_courier')
        || hasApprovedIdentityProfile('motorized_courier');
    }

    // Staged server-controlled rollout. An absent control retains legacy
    // compatibility; an existing invalid control denies protected writes.
    // Never deploy/enable before migration, legal approval and cost review.
    match /social_age_release_private/{documentId} {
      allow read, write: if false;
    }

    function canParticipateInSocialWithAge(userId) {
      let control = /databases/$(database)/documents/social_age_release_private/current;
      let age = /databases/$(database)/documents/age_eligibility_private/$(userId);
      return isSignedIn() && (
        !exists(control)
        || (
          get(control).data.schemaVersion == 1
          && get(control).data.mode == 'verified_adult_only'
          && exists(age)
          && get(age).data.uid == userId
          && get(age).data.status == 'verified_adult'
        )
      );
    }

    function canWriteSocialWithAge() {
      return isSignedIn() && canParticipateInSocialWithAge(request.auth.uid);
    }

    // Separate staged control for commercial eligibility.
    match /erp_age_release_private/{documentId} {
      allow read, write: if false;
    }
    function canParticipateInErpWithAge(userId) {
      let control = /databases/$(database)/documents/erp_age_release_private/current;
      let age = /databases/$(database)/documents/age_eligibility_private/$(userId);
      return isSignedIn() && (
        !exists(control)
        || (
          get(control).data.schemaVersion == 1
          && get(control).data.mode == 'verified_adult_only'
          && exists(age)
          && get(age).data.uid == userId
          && get(age).data.status == 'verified_adult'
        )
      );
    }
    function canWriteErpWithAge() {
      return isSignedIn() && canParticipateInErpWithAge(request.auth.uid);
    }

    // Direct hiring has its own rollout, independent of on-demand delivery.
    match /renda_age_release_private/{documentId} {
      allow read, write: if false;
    }
    function canWriteRendaWithAge() {
      let control = /databases/$(database)/documents/renda_age_release_private/current;
      let age = /databases/$(database)/documents/age_eligibility_private/$(request.auth.uid);
      return isSignedIn() && (
        !exists(control)
        || (
          get(control).data.schemaVersion == 1
          && get(control).data.mode == 'verified_adult_only'
          && exists(age)
          && get(age).data.uid == request.auth.uid
          && get(age).data.status == 'verified_adult'
        )
      );
    }
