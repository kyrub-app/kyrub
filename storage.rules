rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveControlPlaneAdmin() {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/kyrub_admin/control_plane/admins/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/kyrub_admin/control_plane/admins/$(request.auth.uid)
        ).data.status == 'active';
    }

    function communityMembershipId(communityId) {
      return communityId + '__' + request.auth.uid;
    }

    function canReadCommunity(communityId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/communities/$(communityId)
        )
        && (
          firestore.get(
            /databases/(default)/documents/communities/$(communityId)
          ).data.visibility in ['public', 'moderated']
          || firestore.get(
            /databases/(default)/documents/communities/$(communityId)
          ).data.ownerId == request.auth.uid
          || (
            firestore.exists(
              /databases/(default)/documents/community_members/$(communityMembershipId(communityId))
            )
            && firestore.get(
              /databases/(default)/documents/community_members/$(communityMembershipId(communityId))
            ).data.status == 'active'
          )
        );
    }

    function canPublishCommunityMedia(communityId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/communities/$(communityId)
        )
        // getDownloadURL produces a shareable bearer URL; do not create such
        // links for private communities until an authenticated reader exists.
        && firestore.get(
          /databases/(default)/documents/communities/$(communityId)
        ).data.visibility in ['public', 'moderated']
        && (
          firestore.get(
            /databases/(default)/documents/communities/$(communityId)
          ).data.ownerId == request.auth.uid
          || (
            firestore.exists(
              /databases/(default)/documents/community_members/$(communityMembershipId(communityId))
            )
            && firestore.get(
              /databases/(default)/documents/community_members/$(communityMembershipId(communityId))
            ).data.status == 'active'
          )
        );
    }

    match /community-post-media/{communityId}/{ownerId}/{fileName} {
      allow read: if canReadCommunity(communityId);

      allow create: if canPublishCommunityMedia(communityId)
        && request.auth.uid == ownerId
        && request.resource.size > 0
        && (
          (
            request.resource.size <= 8 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)')
          )
          || (
            request.resource.size <= 20 * 1024 * 1024
            && request.resource.contentType.matches('video/(mp4|webm)')
          )
        )
        && request.resource.metadata.communityId == communityId
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.purpose == 'community-wall';

      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == ownerId;
    }

    match /social-posts/{userId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile-images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /app-images/{userId}/{contentHash} {
      allow read: if true;

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.ownerId == userId
        && request.resource.metadata.contentHash == contentHash;

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    // Public promotional Tag images have no permanent download token.
    // Public display goes through the server, which checks blocked + enabled.
    // Only the current verified email owner can upload and privately inspect media.
    match /kyrub-tag-media/{tagId}/{slot}/{assetId} {
      allow read: if isSignedIn()
        && request.auth.token.email_verified == true
        && slot in ['cover', 'avatar']
        && firestore.exists(/databases/(default)/documents/kyrub_official_tags/$(tagId))
        && firestore.get(/databases/(default)/documents/kyrub_official_tags/$(tagId)).data.distribution == 'promotional'
        && firestore.get(/databases/(default)/documents/kyrub_official_tags/$(tagId)).data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && resource == null
        && request.auth.token.email_verified == true
        && slot in ['cover', 'avatar']
        && assetId.matches('[a-f0-9]{32}')
        && firestore.exists(/databases/(default)/documents/kyrub_official_tags/$(tagId))
        && firestore.get(/databases/(default)/documents/kyrub_official_tags/$(tagId)).data.distribution == 'promotional'
        && firestore.get(/databases/(default)/documents/kyrub_official_tags/$(tagId)).data.ownerId == request.auth.uid
        && firestore.get(/databases/(default)/documents/kyrub_official_tags/$(tagId)).data.blocked == false
        && request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/webp'
        && request.resource.metadata.ownerId == request.auth.uid
        && request.resource.metadata.tagId == tagId
        && request.resource.metadata.purpose == slot;

      // New files use fresh random IDs; no replacement or client deletion.
      // Server-side lifecycle cleanup remains a release prerequisite.
      allow update, delete: if false;
    }

    match /community-covers/{communityId}/{ownerId}/{fileName} {
      allow read: if canReadCommunity(communityId);

      allow create, update: if isSignedIn()
        && request.auth.uid == ownerId
        && firestore.exists(
          /databases/(default)/documents/communities/$(communityId)
        )
        && firestore.get(
          /databases/(default)/documents/communities/$(communityId)
        ).data.ownerId == request.auth.uid
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.communityId == communityId
        && request.resource.metadata.ownerId == request.auth.uid;

      allow delete: if isSignedIn()
        && request.auth.uid == ownerId
        && firestore.exists(
          /databases/(default)/documents/communities/$(communityId)
        )
        && firestore.get(
          /databases/(default)/documents/communities/$(communityId)
        ).data.ownerId == request.auth.uid;
    }

    match /identity-verification/{userId}/{kind}/{fileName} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isActiveControlPlaneAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && kind in ['document', 'selfie']
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || (
            kind == 'document'
            && request.resource.contentType == 'application/pdf'
          )
        )
        && request.resource.metadata.ownerId == userId
        && request.resource.metadata.purpose == kind
        && request.resource.metadata.consentVersion is string;

      allow update, delete: if false;
    }

    match /kyrubia-attachments/{userId}/{conversationId}/{attachmentId} {
      allow read: if isSignedIn()
        && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && resource == null
        && request.resource.size > 0
        && (
          (
            request.resource.size <= 8 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)')
          )
          || (
            request.resource.size <= 10 * 1024 * 1024
            && request.resource.contentType == 'application/pdf'
          )
        )
        && request.resource.metadata.ownerId == userId
        && request.resource.metadata.conversationId == conversationId
        && request.resource.metadata.attachmentId == attachmentId
        && request.resource.metadata.purpose == 'kyrubia-conversation';

      allow update: if false;
      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
