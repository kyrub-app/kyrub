rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveControlPlaneAdmin() {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/kyrub_admin/control_plane/admins/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/kyrub_admin/control_plane/admins/$(request.auth.uid)
        ).data.status == 'active';
    }

    match /social-posts/{userId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile-images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /identity-verification/{userId}/{kind}/{fileName} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isActiveControlPlaneAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && kind in ['document', 'selfie']
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || (
            kind == 'document'
            && request.resource.contentType == 'application/pdf'
          )
        )
        && request.resource.metadata.ownerId == userId
        && request.resource.metadata.purpose == kind
        && request.resource.metadata.consentVersion is string;

      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
